<%# ============================================================
     views/layouts/main.ejs — القالب الرئيسي للتطبيق
     كيفية الاستخدام في أي صفحة:
       <%- include('../layouts/main', { body: content }) %>
     أو استخدم <%- body %> مباشرة داخل هذا الملف
     ============================================================ %>
<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="نظام إدارة عيادة الأسنان المتكامل" />

  <%# العنوان الديناميكي %>
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %><%= clinicName %></title>

  <%# Bootstrap 5 RTL CSS %>
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"
    integrity="sha384-dpuaG1suU0eT09tx5plTaGMLBsfDLX5UkJatefjpugtDrry2MhWZs+vl7MeAKzj"
    crossorigin="anonymous"
  />

  <%# Bootstrap Icons %>
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
  />

  <%# التنسيقات المخصصة %>
  <link rel="stylesheet" href="/css/style.css" />

  <%# أيقونة المتصفح %>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🦷</text></svg>" />

  <%# CSS إضافي خاص بالصفحة (اختياري) %>
  <%- typeof extraCSS !== 'undefined' ? extraCSS : '' %>
</head>

<body>

  <%# هيكل التطبيق الرئيسي %>
  <div class="app-wrapper">

    <%# الشريط الجانبي %>
    <%- include('../partials/sidebar') %>

    <%# منطقة المحتوى الرئيسية %>
    <div class="main-content">

      <%# الشريط العلوي %>
      <%- include('../partials/navbar') %>

      <%# محتوى الصفحة %>
      <main class="page-content">

        <%# رسائل Flash — النجاح %>
        <% if (successMsg) { %>
          <div class="flash-alert alert alert-success alert-dismissible" role="alert">
            <span>✅</span>
            <span><%= successMsg %></span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <%# رسائل Flash — الخطأ %>
        <% if (errorMsg) { %>
          <div class="flash-alert alert alert-danger alert-dismissible" role="alert">
            <span>❌</span>
            <span><%= errorMsg %></span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <%# محتوى الصفحة الفعلي يُحقن هنا %>
        <%- body %>

      </main>

      <%# الفوتر %>
      <%- include('../partials/footer') %>

    </div><%# .main-content %>

  </div><%# .app-wrapper %>

  <%# Bootstrap 5 JS Bundle %>
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmw+h3yhJgKQ+2RQj6ctSKD5ZsN"
    crossorigin="anonymous"
  ></script>

  <%# JavaScript الرئيسي %>
  <script src="/js/main.js"></script>

  <%# JS إضافي خاص بالصفحة (اختياري) %>
  <%- typeof extraJS !== 'undefined' ? extraJS : '' %>

</body>
</html>
