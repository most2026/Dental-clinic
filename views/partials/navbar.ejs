<%# ============================================================
     views/partials/navbar.ejs — الشريط العلوي النهائي
     ============================================================ %>

<header class="top-navbar">

  <%# زر Toggle للموبايل %>
  <button class="sidebar-toggle" id="sidebarToggle" aria-label="القائمة">
    ☰
  </button>

  <%# شريط البحث السريع %>
  <div class="navbar-search">
    <input
      type="text"
      class="form-control"
      id="globalSearch"
      placeholder="🔍 بحث سريع..."
      autocomplete="off"
    />
  </div>

  <%# التاريخ الحالي %>
  <div class="navbar-date" id="navbarDate">
    📆 <span id="currentDateDisplay">...</span>
  </div>

  <%# أدوات الـ Navbar %>
  <div class="navbar-actions">

    <%# حجز موعد سريع %>
    <a href="/appointments/new"
       class="navbar-icon-btn" title="حجز موعد جديد">
      📌
    </a>

    <%# الإشعارات %>
    <button class="navbar-icon-btn" title="الإشعارات">
      🔔
    </button>

    <%# قائمة المستخدم المنسدلة %>
    <% if (typeof user !== 'undefined' && user) { %>

      <%
        var roleMap = {
          admin:        'مدير النظام',
          doctor:       'طبيب أسنان',
          receptionist: 'موظف استقبال'
        };
        var roleLabel = roleMap[user.role] || user.role;
      %>

      <div class="dropdown">
        <button
          class="navbar-icon-btn dropdown-toggle"
          data-bs-toggle="dropdown"
          aria-expanded="false"
          style="width:auto; gap:8px; padding:0 12px; font-size:13px; font-weight:600;"
        >
          <%# أفاتار المستخدم %>
          <div style="
            width: 30px; height: 30px; border-radius: 50%;
            background: linear-gradient(135deg, #0d6efd, #6610f2);
            display: inline-flex; align-items: center; justify-content: center;
            color: white; font-weight: 700; font-size: 13px; flex-shrink: 0;">
            <%= user.name ? user.name.charAt(0) : 'م' %>
          </div>
          <span class="d-none d-md-inline"><%= user.name %></span>
        </button>

        <ul class="dropdown-menu dropdown-menu-start shadow-lg border-0 rounded-3"
            style="min-width: 220px;">

          <%# معلومات المستخدم %>
          <li>
            <div class="px-3 py-2">
              <div class="fw-bold" style="font-size:14px;">
                <%= user.name %>
              </div>
              <div class="text-muted" style="font-size:12px;">
                <%= roleLabel %>
              </div>
              <div class="text-muted" style="font-size:11px;" dir="ltr">
                <%= user.email %>
              </div>
            </div>
          </li>

          <li><hr class="dropdown-divider my-1"></li>

          <li>
            <a class="dropdown-item d-flex align-items-center gap-2 py-2"
               href="/auth/profile">
              <span>👤</span>
              <span>الملف الشخصي</span>
            </a>
          </li>

          <li>
            <a class="dropdown-item d-flex align-items-center gap-2 py-2"
               href="/settings">
              <span>⚙️</span>
              <span>الإعدادات</span>
            </a>
          </li>

          <li>
            <a class="dropdown-item d-flex align-items-center gap-2 py-2"
               href="/treatments">
              <span>🩺</span>
              <span>كتالوج العلاجات</span>
            </a>
          </li>

          <li><hr class="dropdown-divider my-1"></li>

          <%# زر تسجيل الخروج %>
          <li>
            <a class="dropdown-item d-flex align-items-center gap-2 py-2 text-danger fw-semibold"
               href="/auth/logout">
              <span>🚪</span>
              <span>تسجيل الخروج</span>
            </a>
          </li>

        </ul>
      </div>

    <% } else { %>

      <%# زر تسجيل الدخول إذا لم يكن مسجلاً %>
      <a href="/auth/login" class="navbar-icon-btn" title="تسجيل الدخول"
         style="font-size:13px; padding:0 12px; width:auto;">
        🔑 دخول
      </a>

    <% } %>

  </div>
</header>
