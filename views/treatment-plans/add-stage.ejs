<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= title %> | <%= clinicName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
  <style>
    .pain-slider { width:100%; accent-color:#0d6efd; }
    .photo-preview-grid {
      display:grid; grid-template-columns:repeat(auto-fill,minmax(100px,1fr)); gap:8px; margin-top:10px;
    }
    .photo-preview-item {
      position:relative; border-radius:10px; overflow:hidden;
      aspect-ratio:1; background:#0f1117; border:1.5px solid #e2e8f0;
    }
    .photo-preview-item img { width:100%; height:100%; object-fit:cover; }
    .photo-preview-item select {
      position:absolute; bottom:0; left:0; right:0;
      font-size:10px; padding:2px 4px; border:none;
      background:rgba(0,0,0,.7); color:#fff; border-radius:0;
    }
    .remove-photo-btn {
      position:absolute; top:3px; right:3px; width:20px; height:20px;
      border-radius:50%; background:rgba(220,53,69,.9); color:#fff;
      border:none; cursor:pointer; font-size:11px; line-height:1;
      display:flex; align-items:center; justify-content:center;
    }
    .dropzone-photos {
      border:2.5px dashed #cbd5e1; border-radius:12px; background:#f8fafc;
      padding:30px; text-align:center; cursor:pointer; transition:.2s; position:relative;
    }
    .dropzone-photos:hover, .dropzone-photos.over { border-color:#0d6efd; background:#e8f0fe; }
    .dropzone-photos input { position:absolute; inset:0; opacity:0; cursor:pointer; }
  </style>
</head>
<body>
<div class="app-wrapper">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/navbar') %>
    <main class="page-content">

      <div class="page-header">
        <div>
          <h1 class="page-title">➕ إضافة مرحلة <%= nextNumber %></h1>
          <p class="page-subtitle">
            <strong><%= plan.title %></strong> —
            <%= plan.patient.firstName %> <%= plan.patient.lastName %>
          </p>
        </div>
        <a href="/treatment-plans/<%= plan._id %>" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-right me-1"></i> العودة
        </a>
      </div>

      <% if (errors && errors.length > 0) { %>
        <div class="flash-alert alert alert-danger alert-dismissible">
          ❌ <%= errors[0] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <form method="POST"
            action="/treatment-plans/<%= plan._id %>/stages"
            enctype="multipart/form-data"
            id="stageForm" novalidate>

        <div class="row g-4">
          <div class="col-12 col-lg-8">

            <%# التاريخ والموعد التالي %>
            <div class="app-card mb-4">
              <div class="app-card-header">
                <h2 class="app-card-title">📅 تواريخ الزيارة</h2>
              </div>
              <div class="app-card-body">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">
                      تاريخ هذه الزيارة <span class="text-danger">*</span>
                    </label>
                    <input type="date" name="visitDate" class="form-control"
                      value="<%= new Date().toISOString().split('T')[0] %>" required/>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">الموعد التالي</label>
                    <input type="date" name="nextVisitDate" class="form-control"/>
                    <div class="form-text">اترك فارغاً إذا لم يُحدَّد بعد</div>
                  </div>
                </div>
              </div>
            </div>

            <%# ── قسم التقويم الشفاف (يظهر دائماً إذا كانت الخطة aligner) %>
            <% if (plan.orthodonticType === 'clear_aligner') { %>
            <div class="app-card mb-4" style="border-color:#7dd3fc;">
              <div class="app-card-header" style="background:linear-gradient(135deg,#e0f2fe,#bae6fd);">
                <h2 class="app-card-title">😁 متابعة الأطقم الشفافة</h2>
                <% if (plan.totalAlignersTrays) { %>
                  <span class="badge" style="background:#0369a1; color:#fff; font-size:11px;">
                    الإجمالي: <%= plan.totalAlignersTrays %> طقم
                  </span>
                <% } %>
              </div>
              <div class="app-card-body">
                <div class="row g-3">
                  <div class="col-md-4">
                    <label class="form-label fw-semibold">رقم الطقم الحالي (بداية)</label>
                    <input type="number" name="alignerTrayStart" class="form-control"
                      value="<%= (plan.currentAlignerTray || 0) + 1 %>"
                      min="1" max="<%= plan.totalAlignersTrays || 100 %>" dir="ltr"/>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label fw-semibold">رقم الطقم الحالي (نهاية)</label>
                    <input type="number" name="alignerTrayEnd" class="form-control"
                      value="<%= (plan.currentAlignerTray || 0) + 1 %>"
                      min="1" max="<%= plan.totalAlignersTrays || 100 %>" dir="ltr"/>
                    <div class="form-text">في حالة تغيير أكثر من طقم</div>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label fw-semibold">ساعات الارتداء/يوم</label>
                    <input type="number" name="wearingHours" class="form-control"
                      value="22" min="0" max="24" dir="ltr"/>
                  </div>
                  <div class="col-12">
                    <label class="form-label fw-semibold d-flex justify-content-between">
                      <span>نسبة الالتزام بالارتداء</span>
                      <span class="text-primary fw-bold" id="complianceVal">100%</span>
                    </label>
                    <input type="range" name="compliance" class="pain-slider"
                      min="0" max="100" value="100"
                      oninput="document.getElementById('complianceVal').textContent=this.value+'%'"/>
                    <div class="d-flex justify-content-between text-muted" style="font-size:11px;">
                      <span>0% — لا ارتداء</span>
                      <span>80%+ — ممتاز</span>
                      <span>100% — مثالي</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <% } %>

            <%# ── قسم التقويم المعدني/الخزفي %>
            <% if (plan.orthodonticType === 'metal' || plan.orthodonticType === 'ceramic' || plan.orthodonticType === 'lingual') { %>
            <div class="app-card mb-4">
              <div class="app-card-header">
                <h2 class="app-card-title">🔩 تفاصيل الأسلاك والتعديلات</h2>
              </div>
              <div class="app-card-body">
                <div class="row g-3">
                  <div class="col-md-4">
                    <label class="form-label fw-semibold">نوع السلك</label>
                    <select name="wireType" class="form-select">
                      <option value="">بدون تغيير سلك</option>
                      <% Object.entries(wireLabels).forEach(function([val,label]) { %>
                        <option value="<%= val %>"><%= label %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label fw-semibold">مقاس السلك</label>
                    <input type="text" name="wireSize" class="form-control"
                      placeholder="مثال: 0.014 أو 0.018×0.025" dir="ltr"/>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label fw-semibold">تعديلات البراكيت</label>
                    <input type="text" name="bracketAdjustment" class="form-control"
                      placeholder="مثال: تعديل torque"/>
                  </div>
                </div>
              </div>
            </div>
            <% } %>

            <%# الإجراءات المنفذة %>
            <div class="app-card mb-4">
              <div class="app-card-header">
                <h2 class="app-card-title">🩺 الإجراءات المنفذة</h2>
              </div>
              <div class="app-card-body">
                <%
                  var procedureOptions = [
                    'تركيب براكيت', 'خلع براكيت', 'تغيير سلك',
                    'تعديل أسلاك', 'تركيب أطقم جديدة', 'تنظيف وتلميع',
                    'أخذ طبعة', 'تصوير أشعة', 'تصوير رقمي',
                    'تركيب مثبت', 'إزالة التقويم', 'متابعة دورية',
                    'تعديل جهاز وظيفي', 'علاج لثة',
                  ];
                %>
                <div class="d-flex flex-wrap gap-2 mb-3">
                  <% procedureOptions.forEach(function(proc) { %>
                    <label class="d-flex align-items-center gap-1"
                           style="background:#f8f9fc; border:1.5px solid #eef0f5;
                                  border-radius:8px; padding:5px 10px; cursor:pointer;
                                  font-size:13px; transition:.15s;"
                           onmouseover="this.style.borderColor='#0d6efd'"
                           onmouseout="this.style.borderColor='#eef0f5'">
                      <input type="checkbox" name="procedures" value="<%= proc %>"
                             class="form-check-input m-0"/>
                      <span><%= proc %></span>
                    </label>
                  <% }) %>
                </div>
                <div>
                  <label class="form-label small text-muted fw-semibold">إجراء مخصص</label>
                  <input type="text" id="customProcInput" class="form-control form-control-sm"
                    placeholder="اكتب إجراءً مخصصاً واضغط Enter..."
                    onkeydown="addCustomProcedure(event)"/>
                  <div id="customProcedures"></div>
                </div>
              </div>
            </div>

            <%# الألم وحركة الأسنان %>
            <div class="app-card mb-4">
              <div class="app-card-header">
                <h2 class="app-card-title">📊 القياسات والملاحظات</h2>
              </div>
              <div class="app-card-body">
                <div class="row g-3">
                  <div class="col-12">
                    <label class="form-label fw-semibold d-flex justify-content-between">
                      <span>مستوى الألم بعد الجلسة</span>
                      <span id="painLabel" style="font-size:15px;">0 — لا يوجد 😊</span>
                    </label>
                    <input type="range" name="painLevel" class="pain-slider"
                      min="0" max="10" value="0" oninput="updatePainLabel(this.value)"/>
                    <div class="d-flex justify-content-between text-muted" style="font-size:11px;">
                      <span>😊 لا يوجد</span>
                      <span>😐 متوسط</span>
                      <span>😣 شديد</span>
                    </div>
                  </div>
                  <div class="col-12">
                    <label class="form-label fw-semibold">حركة الأسنان الملاحَظة</label>
                    <input type="text" name="toothMovement" class="form-control"
                      placeholder="مثال: تحرك الأسنان الأمامية للأمام بمقدار 0.5 ملم..."/>
                  </div>
                  <div class="col-12">
                    <label class="form-label fw-semibold">ملاحظات الطبيب</label>
                    <textarea name="doctorNotes" class="form-control" rows="3"
                      placeholder="الملاحظات التشخيصية والعلاجية..."></textarea>
                  </div>
                  <div class="col-12">
                    <label class="form-label fw-semibold">تعليقات المريض</label>
                    <textarea name="patientFeedback" class="form-control" rows="2"
                      placeholder="ماذا يقول المريض؟ شكاوى، ملاحظات، أسئلة..."></textarea>
                  </div>
                </div>
              </div>
            </div>

            <%# صور المرحلة %>
            <div class="app-card mb-4">
              <div class="app-card-header">
                <h2 class="app-card-title">📸 صور المرحلة</h2>
                <span class="badge bg-secondary-subtle text-secondary">
                  حتى 6 صور • JPG/PNG
                </span>
              </div>
              <div class="app-card-body">

                <div class="dropzone-photos" id="photoDropzone">
                  <input type="file" name="stagePhotos" id="photoInput"
                    accept="image/jpeg,image/png,image/webp" multiple/>
                  <div style="font-size:2.5rem; margin-bottom:8px;">📸</div>
                  <h6 class="fw-semibold mb-1">اسحب الصور هنا أو انقر للاختيار</h6>
                  <p class="text-muted small mb-0">
                    صورة أمامية، جانبية، علوية، سفلية، ابتسامة، أشعة
                  </p>
                </div>

                <div class="photo-preview-grid" id="photoPreviewGrid" style="display:none;"></div>

              </div>
            </div>

          </div>

          <%# الشريط الجانبي %>
          <div class="col-12 col-lg-4">
            <div class="app-card" style="position:sticky; top:80px;">
              <div class="app-card-header">
                <h2 class="app-card-title">📋 ملخص المرحلة</h2>
              </div>
              <div class="app-card-body">

                <%# معلومات الخطة %>
                <div class="mb-3 p-3 rounded-3"
                     style="background:#f8f9fc; border:1px solid #eef0f5;">
                  <div class="fw-semibold small mb-1"><%= plan.title %></div>
                  <div class="text-muted small">
                    <%= plan.patient.firstName %> <%= plan.patient.lastName %>
                  </div>
                  <div class="text-muted small">
                    مرحلة <strong class="text-primary"><%= nextNumber %></strong>
                    من <%= plan.stages.length > 0 ? plan.stages.length + 1 : 1 %> مراحل
                  </div>
                </div>

                <%# التقدم الحالي %>
                <% if (plan.category === 'orthodontic' && plan.orthodonticType === 'clear_aligner' && plan.totalAlignersTrays) { %>
                  <div class="mb-3 p-2 rounded-3" style="background:#e0f2fe; border:1px solid #7dd3fc;">
                    <div class="small fw-semibold" style="color:#0369a1;">😁 وضع الأطقم</div>
                    <div class="small" style="color:#0369a1;">
                      الطقم الحالي: <%= plan.currentAlignerTray || 0 %> /
                      <%= plan.totalAlignersTrays %>
                      (<%= plan.alignerProgress %>%)
                    </div>
                  </div>
                <% } %>

                <div class="alert alert-warning py-2 small mb-3" style="border-radius:10px;">
                  ⚠️ تأكد من رفع الصور قبل الحفظ — لا يمكن إضافتها لاحقاً
                </div>

              </div>
              <div class="app-card-body border-top">
                <button type="submit" class="btn btn-success w-100 py-2" id="submitBtn">
                  <i class="bi bi-check-circle-fill me-1"></i>
                  حفظ المرحلة <%= nextNumber %>
                </button>
                <a href="/treatment-plans/<%= plan._id %>"
                   class="btn btn-outline-secondary w-100 mt-2">إلغاء</a>
              </div>
            </div>
          </div>

        </div>
      </form>

    </main>
    <%- include('../partials/footer') %>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
<script>
// ── عداد الألم ───────────────────────────────────────────────
var painEmojis = ['😊','😊','🙂','🙂','😐','😐','😟','😟','😣','😣','😫'];
var painTexts  = ['لا يوجد','خفيف جداً','خفيف','خفيف','متوسط','متوسط',
                  'متوسط-شديد','شديد','شديد','شديد جداً','لا يُحتمل'];
function updatePainLabel(v) {
  document.getElementById('painLabel').textContent =
    v + ' — ' + painTexts[v] + ' ' + painEmojis[v];
}

// ── إجراء مخصص ──────────────────────────────────────────────
var customProcs = [];
function addCustomProcedure(e) {
  if (e.key !== 'Enter') return;
  e.preventDefault();
  var val = document.getElementById('customProcInput').value.trim();
  if (!val) return;
  customProcs.push(val);
  document.getElementById('customProcInput').value = '';
  renderCustomProcedures();
}
function renderCustomProcedures() {
  var container = document.getElementById('customProcedures');
  container.innerHTML = customProcs.map(function(p, i) {
    return '<span class="badge bg-primary-subtle text-primary me-1 mt-1" style="font-size:12px;">' +
      p + '<input type="hidden" name="procedures" value="' + p + '">' +
      '<button type="button" onclick="removeCustomProc(' + i + ')" ' +
      'style="background:none;border:none;color:#dc2626;padding:0 0 0 4px;cursor:pointer;">×</button>' +
      '</span>';
  }).join('');
}
function removeCustomProc(i) {
  customProcs.splice(i, 1);
  renderCustomProcedures();
}

// ── معاينة الصور ─────────────────────────────────────────────
var selectedFiles = [];
var ANGLE_OPTIONS = ['front','left','right','upper','lower','smile','xray','other'];
var ANGLE_LABELS  = {
  front:'أمامي', left:'جانبي أيسر', right:'جانبي أيمن',
  upper:'علوي', lower:'سفلي', smile:'ابتسامة', xray:'أشعة', other:'أخرى'
};

document.getElementById('photoInput').addEventListener('change', function() {
  handlePhotos([...this.files]);
});

var dropzone = document.getElementById('photoDropzone');
dropzone.addEventListener('dragover', function(e) { e.preventDefault(); dropzone.classList.add('over'); });
dropzone.addEventListener('dragleave', function() { dropzone.classList.remove('over'); });
dropzone.addEventListener('drop', function(e) {
  e.preventDefault(); dropzone.classList.remove('over');
  handlePhotos([...e.dataTransfer.files]);
});

function handlePhotos(files) {
  files.forEach(function(f) {
    if (selectedFiles.length >= 6) return;
    if (!f.type.startsWith('image/')) return;
    selectedFiles.push({ file: f, angle: 'front' });
  });
  renderPreviews();
}

function renderPreviews() {
  var grid = document.getElementById('photoPreviewGrid');
  if (selectedFiles.length === 0) { grid.style.display = 'none'; return; }
  grid.style.display = 'grid';
  grid.innerHTML = selectedFiles.map(function(item, i) {
    var url = URL.createObjectURL(item.file);
    var opts = ANGLE_OPTIONS.map(function(a) {
      return '<option value="' + a + '"' + (item.angle===a?' selected':'') + '>' + ANGLE_LABELS[a] + '</option>';
    }).join('');
    return '<div class="photo-preview-item">' +
      '<img src="' + url + '" alt=""/>' +
      '<select name="photoAngles" onchange="selectedFiles[' + i + '].angle=this.value">' + opts + '</select>' +
      '<button type="button" class="remove-photo-btn" onclick="removePhoto(' + i + ')">×</button>' +
      '</div>';
  }).join('');

  // إعادة بناء FileList
  var dt = new DataTransfer();
  selectedFiles.forEach(function(item) { dt.items.add(item.file); });
  document.getElementById('photoInput').files = dt.files;
}

function removePhoto(i) {
  selectedFiles.splice(i, 1);
  renderPreviews();
}

// ── مؤشر التحميل عند الإرسال ─────────────────────────────────
document.getElementById('stageForm').addEventListener('submit', function() {
  var btn = document.getElementById('submitBtn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>جاري الحفظ...';
});
</script>
</body>
</html>
