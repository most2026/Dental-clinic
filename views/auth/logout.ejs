<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>تسجيل الخروج | <%= clinicName %></title>

  <%# إعادة توجيه تلقائية لصفحة الدخول بعد 4 ثواني %>
  <meta http-equiv="refresh" content="4;url=/auth/login"/>

  <link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"/>
  <link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap"/>

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Tajawal', 'Segoe UI', sans-serif;
      min-height: 100vh;
      background: linear-gradient(135deg, #1a1f36 0%, #0d1b4b 60%, #1a1f36 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      overflow: hidden;
    }

    /* دوائر خلفية زخرفية */
    .bg-circle {
      position: fixed;
      border-radius: 50%;
      opacity: 0.06;
      pointer-events: none;
    }
    .bg-circle-1 {
      width: 500px; height: 500px;
      background: #0d6efd;
      top: -150px; right: -150px;
    }
    .bg-circle-2 {
      width: 400px; height: 400px;
      background: #6610f2;
      bottom: -120px; left: -120px;
    }

    /* البطاقة الرئيسية */
    .logout-card {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-radius: 24px;
      padding: 50px 40px;
      text-align: center;
      max-width: 460px;
      width: 100%;
      box-shadow:
        0 24px 64px rgba(0, 0, 0, 0.4),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
      animation: fadeInUp 0.5s ease forwards;
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0);    }
    }

    /* أيقونة الشعار */
    .brand-icon {
      width: 80px;
      height: 80px;
      border-radius: 22px;
      background: linear-gradient(135deg, #0d6efd, #6610f2);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 38px;
      margin-bottom: 20px;
      box-shadow: 0 8px 32px rgba(13, 110, 253, 0.4);
    }

    /* أيقونة الخروج المتحركة */
    .logout-icon {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      background: rgba(220, 53, 69, 0.15);
      border: 2px solid rgba(220, 53, 69, 0.3);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 30px;
      margin-bottom: 24px;
      animation: pulseIcon 2s ease infinite;
    }

    @keyframes pulseIcon {
      0%, 100% { transform: scale(1);    box-shadow: 0 0 0 0   rgba(220,53,69,0.3); }
      50%       { transform: scale(1.06); box-shadow: 0 0 0 12px rgba(220,53,69,0);   }
    }

    .clinic-name {
      color: rgba(255, 255, 255, 0.5);
      font-size: 13px;
      margin-bottom: 6px;
      letter-spacing: 0.5px;
    }

    .goodbye-title {
      color: #ffffff;
      font-size: 26px;
      font-weight: 800;
      margin-bottom: 10px;
    }

    .goodbye-sub {
      color: rgba(255, 255, 255, 0.5);
      font-size: 14px;
      line-height: 1.7;
      margin-bottom: 32px;
    }

    /* شريط التقدم للعد التنازلي */
    .countdown-bar-wrap {
      height: 4px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 10px;
      overflow: hidden;
      margin-bottom: 10px;
    }

    .countdown-bar {
      height: 100%;
      border-radius: 10px;
      background: linear-gradient(90deg, #0d6efd, #6610f2);
      width: 100%;
      animation: shrink 4s linear forwards;
      transform-origin: right;
    }

    @keyframes shrink {
      from { width: 100%; }
      to   { width: 0%;   }
    }

    .countdown-text {
      color: rgba(255, 255, 255, 0.4);
      font-size: 12px;
      margin-bottom: 24px;
    }

    .countdown-text span {
      color: rgba(255, 255, 255, 0.7);
      font-weight: 700;
    }

    /* زر تسجيل الدخول */
    .btn-login {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 13px 24px;
      border-radius: 14px;
      border: none;
      background: linear-gradient(135deg, #0d6efd, #6610f2);
      color: #fff;
      font-size: 15px;
      font-weight: 700;
      font-family: 'Tajawal', sans-serif;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s;
      box-shadow: 0 6px 20px rgba(13, 110, 253, 0.35);
      margin-bottom: 12px;
    }

    .btn-login:hover {
      color: #fff;
      transform: translateY(-2px);
      box-shadow: 0 10px 28px rgba(13, 110, 253, 0.45);
    }

    /* معلومات المستخدم */
    .user-farewell {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      padding: 12px 16px;
      margin-bottom: 28px;
    }

    .user-avatar-sm {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, #0d6efd, #6610f2);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: 800;
      font-size: 16px;
      flex-shrink: 0;
    }

    .user-info-sm { text-align: right; }

    .user-name-sm {
      color: #fff;
      font-size: 14px;
      font-weight: 700;
      line-height: 1.3;
    }

    .user-role-sm {
      color: rgba(255, 255, 255, 0.45);
      font-size: 11px;
    }

    .divider {
      border: none;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      margin: 20px 0;
    }

    .footer-note {
      color: rgba(255, 255, 255, 0.25);
      font-size: 11px;
    }
  </style>
</head>
<body>

  <%# دوائر خلفية %>
  <div class="bg-circle bg-circle-1"></div>
  <div class="bg-circle bg-circle-2"></div>

  <div class="logout-card">

    <%# شعار العيادة %>
    <div class="brand-icon">🦷</div>
    <div class="clinic-name"><%= clinicName %></div>

    <%# أيقونة الخروج %>
    <div class="logout-icon">🚪</div>

    <%# رسالة الوداع %>
    <h1 class="goodbye-title">إلى اللقاء! 👋</h1>
    <p class="goodbye-sub">
      تم تسجيل خروجك بنجاح وبأمان تام.<br/>
      نتمنى لك يوماً موفقاً.
    </p>

    <%# بيانات المستخدم المُودَّع %>
    <% if (typeof loggedOutUser !== 'undefined' && loggedOutUser) { %>
      <div class="user-farewell">
        <div class="user-avatar-sm">
          <%= loggedOutUser.initial %>
        </div>
        <div class="user-info-sm">
          <div class="user-name-sm"><%= loggedOutUser.name %></div>
          <div class="user-role-sm"><%= loggedOutUser.roleLabel %></div>
        </div>
      </div>
    <% } %>

    <%# شريط العد التنازلي %>
    <div class="countdown-bar-wrap">
      <div class="countdown-bar"></div>
    </div>
    <div class="countdown-text">
      سيتم توجيهك لصفحة الدخول خلال
      <span id="countdownNum">4</span> ثواني...
    </div>

    <%# زر العودة للدخول %>
    <a href="/auth/login" class="btn-login">
      <span>🔑</span>
      <span>تسجيل الدخول مجدداً</span>
    </a>

    <hr class="divider"/>

    <div class="footer-note">
      &copy; <%= currentYear %> <%= clinicName %> — نظام إدارة عيادة الأسنان
    </div>

  </div>

  <script>
    // ── عداد تنازلي ──────────────────────────────────────────
    var count   = 4;
    var display = document.getElementById('countdownNum');

    var timer = setInterval(function () {
      count--;
      if (display) display.textContent = count;
      if (count <= 0) {
        clearInterval(timer);
        window.location.href = '/auth/login';
      }
    }, 1000);

    // إيقاف العداد إذا نقر المستخدم الزر مباشرة
    document.querySelector('.btn-login').addEventListener('click', function () {
      clearInterval(timer);
    });
  </script>

</body>
</html>
