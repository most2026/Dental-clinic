<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> | <%= clinicName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
  <style>
    /* تحسينات إضافية للمظهر */
    .status-badge { padding: 0.5em 1em; border-radius: 50px; font-size: 0.85rem; font-weight: 600; }
    .badge-scheduled { background-color: #e0f2fe; color: #0369a1; }
    .badge-completed { background-color: #dcfce7; color: #15803d; }
    .badge-cancelled { background-color: #fee2e2; color: #b91c1c; }
    .badge-noshow { background-color: #f1f5f9; color: #475569; }
    
    .detail-row:last-child { border-bottom: none !important; }
    .patient-avatar { background: var(--primary); color: white; display: flex; align-items: center; justify-content: center; border-radius: 12px; }
  </style>
</head>
<body>
<div class="app-wrapper">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/navbar') %>
    <main class="page-content container-fluid py-4">

      <% if (locals.successMsg) { %>
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4">
          <i class="bi bi-check-circle-fill me-2"></i> <%= successMsg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
          <h1 class="page-title h3 mb-1 text-dark">📋 تفاصيل الموعد</h1>
          <p class="text-muted mb-0">
            <i class="bi bi-calendar3 me-1"></i>
            <%= new Date(appointment.appointmentDate).toLocaleDateString('ar-IQ',{weekday:'long',year:'numeric',month:'long',day:'numeric'}) %>
            <span class="mx-2 text-silver">|</span>
            <i class="bi bi-clock me-1"></i> <strong><%= appointment.startTime %></strong>
          </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <a href="/appointments/<%= appointment._id %>/edit" class="btn btn-white shadow-sm border btn-sm px-3">
            <i class="bi bi-pencil me-1 text-primary"></i> تعديل
          </a>
          <% if (!appointment.invoice) { %>
            <a href="/invoices/new?appointment=<%= appointment._id %>&patient=<%= appointment.patient._id %>"
               class="btn btn-warning btn-sm px-3 shadow-sm text-dark">
              <i class="bi bi-receipt me-1"></i> إنشاء فاتورة
            </a>
          <% } %>
          <a href="/appointments" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </div>

      <div class="row g-4">

        <%-- العمود الأيمن: تفاصيل الموعد --%>
        <div class="col-12 col-lg-7">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
              <h5 class="card-title mb-0 fw-bold"><i class="bi bi-info-circle me-2 text-primary"></i>بيانات الجلسة</h5>
              <span class="status-badge badge-<%= appointment.status %>" id="headerBadge">
                <%= statusLabels[appointment.status] %>
              </span>
            </div>
            <div class="card-body">
              <div class="row g-0">
                <% 
                  const aptDetails = [
                    { icon:'bi-calendar-event', label:'التاريخ', value: new Date(appointment.appointmentDate).toLocaleDateString('ar-IQ',{year:'numeric',month:'long',day:'numeric'}) },
                    { icon:'bi-hourglass-split', label:'مدة الموعد', value: appointment.duration + ' دقيقة' },
                    { icon:'bi-clock-history', label:'التوقيت الفعلي', value: `${appointment.startTime} - ${appointment.endTime || '...'}` },
                    { icon:'bi-capsule', label:'نوع العلاج', value: treatmentTypes[appointment.treatmentType] || appointment.treatmentType },
                  ] 
                %>
                <% aptDetails.forEach(item => { %>
                  <div class="col-6 detail-row border-bottom py-3 px-2">
                    <div class="text-muted small mb-1"><i class="bi <%= item.icon %> me-1"></i> <%= item.label %></div>
                    <div class="fw-bold"><%= item.value %></div>
                  </div>
                <% }) %>
              </div>

              <% if (appointment.chiefComplaint) { %>
                <div class="mt-4">
                  <h6 class="fw-bold text-dark mb-2"><i class="bi bi-chat-dots me-2 text-primary"></i>الشكوى الأساسية</h6>
                  <div class="p-3 rounded-3 bg-light border-start border-primary border-4 small text-secondary">
                    <%= appointment.chiefComplaint %>
                  </div>
                </div>
              <% } %>

              <% if (appointment.sessionNotes) { %>
                <div class="mt-4">
                  <h6 class="fw-bold text-dark mb-2"><i class="bi bi-journal-text me-2 text-primary"></i>ملاحظات الطبيب</h6>
                  <div class="p-3 rounded-3 bg-light small">
                    <%= appointment.sessionNotes %>
                  </div>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <%-- العمود الأيسر: المريض والإجراءات --%>
        <div class="col-12 col-lg-5">
          
          <%-- بطاقة المريض --%>
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
              <div class="d-flex align-items-center gap-3">
                <div class="patient-avatar" style="width:60px;height:60px;font-size:24px; flex-shrink: 0;">
                  <%= appointment.patient.firstName.charAt(0) %>
                </div>
                <div class="flex-grow-1 overflow-hidden">
                  <h5 class="fw-bold mb-1 text-truncate"><%= appointment.patient.firstName %> <%= appointment.patient.lastName %></h5>
                  <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-light text-primary border border-primary-subtle small"><%= appointment.patient.patientCode %></span>
                    <small class="text-muted"><i class="bi bi-telephone"></i> <%= appointment.patient.phone %></small>
                  </div>
                </div>
                <a href="/patients/<%= appointment.patient._id %>" class="btn btn-sm btn-light border">
                   الملف
                </a>
              </div>
              
              <% if (appointment.patient.medicalHistory?.allergies?.length > 0) { %>
                <div class="alert alert-danger py-2 px-3 mb-0 mt-3 small border-0 shadow-sm">
                  <i class="bi bi-exclamation-triangle-fill me-1"></i> <strong>حساسية:</strong>
                  <%= appointment.patient.medicalHistory.allergies.join('، ') %>
                </div>
              <% } %>
            </div>
          </div>

          <%-- تحديث الحالة --%>
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3">
              <h6 class="fw-bold mb-0">تحديث حالة الموعد</h6>
            </div>
            <div class="card-body pt-0">
              <div class="row g-2">
                <% Object.entries(statusLabels).forEach(([val, label]) => { %>
                  <div class="col-6">
                    <button
                      class="btn btn-sm w-100 py-2 btn-status-selector <%= appointment.status === val ? 'btn-primary shadow-sm' : 'btn-outline-light text-dark border' %>"
                      data-status-val="<%= val %>"
                      onclick="updateAptStatus('<%= appointment._id %>', '<%= val %>', this)">
                      <%= label %>
                    </button>
                  </div>
                <% }) %>
              </div>

              <% if (appointment.invoice) { %>
                <hr class="my-4 opacity-50">
                <div class="d-flex justify-content-between align-items-center p-3 rounded-3 bg-success-subtle border border-success-subtle">
                  <div>
                    <div class="small fw-bold text-success mb-1">تمت الفوترة</div>
                    <code class="text-dark"><%= appointment.invoice.invoiceNumber %></code>
                  </div>
                  <a href="/invoices/<%= appointment.invoice._id %>" class="btn btn-sm btn-success">عرض الفاتورة</a>
                </div>
              <% } %>
            </div>
          </div>

        </div>
      </div>

    </main>
    <%- include('../partials/footer') %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
async function updateAptStatus(id, status, btn) {
  // تفعيل حالة التحميل البصري
  const originalText = btn.textContent;
  btn.innerHTML = `<span class="spinner-border spinner-border-sm"></span>`;
  btn.disabled = true;

  try {
    const res = await fetch(`/appointments/${id}/status`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status }),
    });
    const data = await res.json();

    if (data.success) {
      // تحديث أزرار الحالة
      document.querySelectorAll('.btn-status-selector').forEach(b => {
        b.classList.remove('btn-primary', 'shadow-sm');
        b.classList.add('btn-outline-light', 'text-dark', 'border');
      });
      btn.classList.remove('btn-outline-light', 'text-dark', 'border');
      btn.classList.add('btn-primary', 'shadow-sm');
      btn.innerHTML = originalText;
      btn.disabled = false;

      // تحديث الـ badge العلوي
      const badge = document.getElementById('headerBadge');
      if (badge) {
        badge.className = `status-badge badge-${status}`;
        badge.textContent = data.statusLabel || originalText.trim();
      }
    } else {
      throw new Error(data.message || 'حدث خطأ ما');
    }
  } catch (err) {
    alert('❌ ' + err.message);
    btn.innerHTML = originalText;
    btn.disabled = false;
  }
}
</script>
</body>
</html>
