<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> | <%= clinicName %></title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>

<body>

<div class="app-wrapper">

  <%- include('../partials/sidebar') %>

  <div class="main-content">

    <%- include('../partials/navbar') %>

    <main class="page-content">

      <%# تنبيهات النظام %>

      <% if (locals.successMsg) { %>
        <div class="alert alert-success alert-dismissible fade show">
          ✅ <%= successMsg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <% if (locals.errorMsg) { %>
        <div class="alert alert-danger alert-dismissible fade show">
          ❌ <%= errorMsg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <div class="page-header d-flex justify-content-between align-items-center mb-4">

        <div>
          <h1 class="page-title h3 mb-1">📅 المواعيد</h1>
          <p class="text-muted mb-0">
            إجمالي:
            <strong><%= pagination.totalCount %></strong>
            موعد
          </p>
        </div>

        <div class="d-flex gap-2">
          <a href="/appointments/today" class="btn btn-outline-info border-2">
            <i class="bi bi-calendar-day"></i>
            تقويم اليوم
          </a>

          <a href="/appointments/new" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            حجز موعد
          </a>
        </div>

      </div>

      <%# فلاتر البحث %>

      <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

          <form method="GET" action="/appointments" class="row g-3 align-items-end">

            <div class="col-6 col-md-3">
              <label class="form-label small fw-bold">
                من تاريخ
              </label>

              <input
                type="date"
                name="dateFrom"
                class="form-control"
                value="<%= filters.dateFrom || '' %>"
              />
            </div>

            <div class="col-6 col-md-3">
              <label class="form-label small fw-bold">
                إلى تاريخ
              </label>

              <input
                type="date"
                name="dateTo"
                class="form-control"
                value="<%= filters.dateTo || '' %>"
              />
            </div>

            <div class="col-6 col-md-2">

              <label class="form-label small fw-bold">
                الحالة
              </label>

              <select name="status" class="form-select">

                <option value="">الكل</option>

                <% Object.entries(statusLabels).forEach(([val, label]) => { %>

                  <option
                    value="<%= val %>"
                    <%= filters.status === val ? 'selected' : '' %>
                  >
                    <%= label %>
                  </option>

                <% }) %>

              </select>

            </div>

            <div class="col-6 col-md-3">

              <label class="form-label small fw-bold">
                نوع العلاج
              </label>

              <select name="treatmentType" class="form-select">

                <option value="">الكل</option>

                <% Object.entries(treatmentTypes).forEach(([val, label]) => { %>

                  <option
                    value="<%= val %>"
                    <%= filters.treatmentType === val ? 'selected' : '' %>
                  >
                    <%= label %>
                  </option>

                <% }) %>

              </select>

            </div>

            <div class="col-12 col-md-1">
              <button type="submit" class="btn btn-primary w-100 py-2">
                <i class="bi bi-search"></i>
              </button>
            </div>

          </form>

        </div>

      </div>

      <%# جدول المواعيد %>

      <div class="card border-0 shadow-sm">

        <div class="table-responsive">

          <% if (appointments && appointments.length > 0) { %>

            <table class="table table-hover align-middle mb-0">

              <thead class="bg-light">

                <tr>
                  <th class="ps-3">المريض</th>
                  <th>التاريخ والوقت</th>
                  <th>المدة</th>
                  <th>نوع العلاج</th>
                  <th>الحالة</th>
                  <th class="text-end pe-3">الإجراءات</th>
                </tr>

              </thead>

              <tbody>

                <% appointments.forEach(apt => { %>

                  <tr>

                    <td class="ps-3">

                      <div class="d-flex align-items-center gap-2">

                        <div
                          class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                          style="width:35px; height:35px;"
                        >
                          <%= apt.patient && apt.patient.firstName
                            ? apt.patient.firstName.charAt(0)
                            : '؟'
                          %>
                        </div>

                        <div>

                          <% if (apt.patient) { %>

                            <a
                              href="/patients/<%= apt.patient._id %>"
                              class="fw-bold text-decoration-none text-dark d-block"
                            >
                              <%= apt.patient.firstName %>
                              <%= apt.patient.lastName %>
                            </a>

                            <code class="small text-muted">
                              <%= apt.patient.patientCode %>
                            </code>

                          <% } else { %>

                            <span class="text-danger">
                              مريض محذوف
                            </span>

                          <% } %>

                        </div>

                      </div>

                    </td>

                    <td>

                      <div class="fw-bold">
                        <%= new Date(apt.appointmentDate).toLocaleDateString('ar-EG') %>
                      </div>

                      <div class="small text-primary fw-bold">
                        <%= apt.startTime %>
                      </div>

                    </td>

                    <td>
                      <span class="badge bg-light text-dark border font-monospace">
                        <%= apt.duration %> د
                      </span>
                    </td>

                    <td>
                      <%= treatmentTypes[apt.treatmentType] || apt.treatmentType %>
                    </td>

                    <td>

                      <select
                        class="form-select form-select-sm status-select border-0 bg-light"
                        style="width:auto;"
                        data-id="<%= apt._id %>"
                        onchange="updateStatus(this)"
                      >

                        <% Object.entries(statusLabels).forEach(([val, label]) => { %>

                          <option
                            value="<%= val %>"
                            <%= apt.status === val ? 'selected' : '' %>
                          >
                            <%= label %>
                          </option>

                        <% }) %>

                      </select>

                    </td>

                    <td class="text-end pe-3">

                      <div class="btn-group shadow-sm">

                        <a
                          href="/appointments/<%= apt._id %>"
                          class="btn btn-sm btn-white text-primary"
                          title="عرض"
                        >
                          <i class="bi bi-eye"></i>
                        </a>

                        <a
                          href="/appointments/<%= apt._id %>/edit"
                          class="btn btn-sm btn-white text-secondary"
                          title="تعديل"
                        >
                          <i class="bi bi-pencil"></i>
                        </a>

                        <button
                          class="btn btn-sm btn-white text-danger"
                          onclick="cancelAppointment('<%= apt._id %>')"
                          title="إلغاء"
                        >
                          <i class="bi bi-trash"></i>
                        </button>

                      </div>

                    </td>

                  </tr>

                <% }) %>

              </tbody>

            </table>

          <% } else { %>

            <div class="text-center py-5">

              <i
                class="bi bi-calendar-x text-muted"
                style="font-size: 3rem;"
              ></i>

              <h5 class="mt-3 text-muted">
                لا توجد مواعيد مطابقة للبحث
              </h5>

              <a href="/appointments/new" class="btn btn-primary btn-sm mt-2">
                إضافة موعد جديد
              </a>

            </div>

          <% } %>

        </div>

        <%# ترقيم الصفحات %>

        <% if (pagination.totalPages > 1) { %>

          <div class="card-footer bg-white py-3 d-flex justify-content-between align-items-center">

            <span class="small text-muted">
              عرض صفحة
              <%= pagination.currentPage %>
              من
              <%= pagination.totalPages %>
            </span>

            <nav>

              <ul class="pagination pagination-sm mb-0">

                <%
                  const getPageUrl = (p) =>
                    `?page=${p}&status=${filters.status || ''}&treatmentType=${filters.treatmentType || ''}&dateFrom=${filters.dateFrom || ''}&dateTo=${filters.dateTo || ''}`;
                %>

                <li class="page-item <%= !pagination.hasPrev ? 'disabled' : '' %>">

                  <a
                    class="page-link"
                    href="<%= getPageUrl(pagination.currentPage - 1) %>"
                  >
                    السابق
                  </a>

                </li>

                <% for(let i = 1; i <= pagination.totalPages; i++) { %>

                  <li class="page-item <%= pagination.currentPage == i ? 'active' : '' %>">

                    <a
                      class="page-link"
                      href="<%= getPageUrl(i) %>"
                    >
                      <%= i %>
                    </a>

                  </li>

                <% } %>

                <li class="page-item <%= !pagination.hasNext ? 'disabled' : '' %>">

                  <a
                    class="page-link"
                    href="<%= getPageUrl(pagination.currentPage + 1) %>"
                  >
                    التالي
                  </a>

                </li>

              </ul>

            </nav>

          </div>

        <% } %>

      </div>

    </main>

    <%- include('../partials/footer') %>

  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>

async function updateStatus(selectEl) {

  const id = selectEl.dataset.id;
  const status = selectEl.value;

  selectEl.disabled = true;

  try {

    const res = await fetch(`/appointments/${id}/status`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ status }),
    });

    let data;

    try {
      data = await res.json();
    } catch {
      throw new Error('استجابة غير صالحة من السيرفر');
    }

    if (!data.success) {
      alert('❌ ' + (data.message || 'فشل التحديث'));
      location.reload();
    }

  } catch (err) {

    alert('❌ فشل الاتصال بالسيرفر');

  } finally {

    selectEl.disabled = false;

  }

}

async function cancelAppointment(id) {

  const confirmed = confirm(
    'هل أنت متأكد من رغبتك في إلغاء هذا الموعد نهائياً؟'
  );

  if (!confirmed) return;

  try {

    const res = await fetch(`/appointments/${id}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json'
      }
    });

    let data;

    try {
      data = await res.json();
    } catch {
      throw new Error('استجابة غير صالحة من السيرفر');
    }

    if (data.success) {

      location.reload();

    } else {

      alert('❌ ' + (data.message || 'فشل حذف الموعد'));

    }

  } catch (err) {

    alert('❌ خطأ في تنفيذ العملية');

  }

}

</script>

</body>
</html>
