<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> | <%= clinicName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="app-wrapper">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/navbar') %>
    <main class="page-content">

      <% if (successMsg) { %>
        <div class="flash-alert alert alert-success alert-dismissible">
          ✅ <%= successMsg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <div class="page-header">
        <div>
          <h1 class="page-title">⚙️ إعدادات النظام</h1>
          <p class="page-subtitle">إدارة المستخدمين ومعلومات النظام</p>
        </div>
      </div>

      <div class="row g-4">

        <%# إحصائيات النظام %>
        <div class="col-12">
          <div class="app-card">
            <div class="app-card-header">
              <h2 class="app-card-title">📊 إحصائيات قاعدة البيانات</h2>
            </div>
            <div class="app-card-body">
              <div class="row g-3">
                <% var sysItems = [
                  { icon:'👥', label:'المرضى',      value: systemStats.totalPatients,     color:'#e8f0fe' },
                  { icon:'📅', label:'المواعيد',     value: systemStats.totalAppointments, color:'#fef3c7' },
                  { icon:'🧾', label:'الفواتير',     value: systemStats.totalInvoices,     color:'#dcfce7' },
                  { icon:'🩺', label:'العلاجات',     value: systemStats.totalTreatments,   color:'#ede9fe' },
                  { icon:'👤', label:'المستخدمون',   value: systemStats.totalUsers,        color:'#fee2e2' },
                ]; %>
                <% sysItems.forEach(function(item) { %>
                  <div class="col-6 col-md-4 col-lg-2">
                    <div class="text-center p-3 rounded-3 border"
                       le="background:<%= item.color %>;"></div>  sty
                      <div style="font-size:2rem;"><%= item.icon %></div>
                      <div class="fw-bold fs-4 mt-1"><%= item.value %></div>
                      <div class="small text-muted"><%= item.label %></div>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>
        </div>

        <%# معلومات النظام %>
        <div class="col-12 col-lg-4">
          <div class="app-card h-100">
            <div class="app-card-header">
              <h2 class="app-card-title">🖥️ معلومات النظام</h2>
            </div>
            <div class="app-card-body">
              <dl class="row g-0 mb-0">
                <% var sysInfo = [
                  { label:'اسم العيادة',    value: clinicName },
                  { label:'إصدار Node.js',  value: nodeVersion },
                  { label:'بيئة التشغيل',   value: env },
                  { label:'إصدار النظام',   value: 'v1.0.0' },
                ]; %>
                <% sysInfo.forEach(function(info) { %>
                  <dt class="col-5 text-muted small py-2 border-bottom"><%= info.label %></dt>
                  <dd class="col-7 fw-semibold small py-2 border-bottom mb-0">
                    <code><%= info.value %></code>
                  </dd>
                <% }) %>
              </dl>
              <div class="mt-3 d-flex flex-column gap-2">
                <a href="/auth/profile" class="btn btn-outline-primary btn-sm">
                  <i class="bi bi-person-gear me-1"></i> الملف الشخصي
                </a>
                <a href="/treatments" class="btn btn-outline-info btn-sm">
                  <i class="bi bi-grid me-1"></i> كتالوج العلاجات
                </a>
                
              </div>
            </div>
          </div>
        </div>

        <%# إدارة المستخدمين %>
        <div class="col-12 col-lg-8">
          <div class="app-card h-100">
            <div class="app-card-header">
              <h2 class="app-card-title">👥 إدارة المستخدمين</h2>
              <% if (user && user.role === 'admin') { %>
                <a href="/auth/register" class="btn btn-sm btn-primary">
                  <i class="bi bi-person-plus me-1"></i> مستخدم جديد
                </a>
              <% } %>
            </div>

            <% if (users && users.length > 0) { %>
            <div class="app-card-table">
              <table class="app-table">
                <thead>
                  <tr>
                    <th>المستخدم</th>
                    <th>البريد الإلكتروني</th>
                    <th>الدور</th>
                    <th>آخر دخول</th>
                    <th>الحالة</th>
                    <% if (user && user.role === 'admin') { %>
                      <th>الإجراءات</th>
                    <% } %>
                  </tr>
                </thead>
                <tbody>
                  <% users.forEach(function(u) {
                    var roleBadge = { admin:'bg-danger', doctor:'bg-primary', receptionist:'bg-success' };
                    var roleLabel = { admin:'مدير', doctor:'طبيب', receptionist:'استقبال' };
                    var lastLogin = u.lastLogin
                      ? new Date(u.lastLogin).toLocaleDateString('ar-IQ')
                      : 'لم يسجّل بعد';
                    var isCurrent = user && u._id.toString() === user._id.toString();
                  %>
                  <tr id="user-row-<%= u._id %>">
                    <td>
                      <div class="d-flex align-items-center gap-2">
                        <div class="patient-avatar" style="width:34px;height:34px;font-size:13px;">
                          <%= u.name.charAt(0) %>
                        </div>
                        <div>
                          <div class="fw-semibold small">
                            <%= u.name %>
                            <% if (isCurrent) { %>
                              <span class="badge bg-primary-subtle text-primary ms-1"
                                    style="font-size:10px;">أنت</span>
                            <% } %>
                          </div>
                        </div>
                      </div>
                    </td>
                    <td class="small text-muted" dir="ltr"><%= u.email %></td>
                    <td>
                      <span class="badge <%= roleBadge[u.role] || 'bg-secondary' %>">
                        <%= roleLabel[u.role] || u.role %>
                      </span>
                    </td>
                    <td class="small text-muted"><%= lastLogin %></td>
                    <td>
                      <% if (isCurrent) { %>
                        <span class="status-badge badge-active">نشط</span>
                      <% } else if (user && user.role === 'admin') { %>
                        <div class="form-check form-switch mb-0">
                          <input class="form-check-input" type="checkbox"
                            <%= u.isActive ? 'checked' : '' %>
                            onchange="toggleUser('<%= u._id %>', this)"/>
                        </div>
                      <% } else { %>
                        <span class="status-badge badge-<%= u.isActive ? 'active' : 'inactive' %>">
                          <%= u.isActive ? 'نشط' : 'معطّل' %>
                        </span>
                      <% } %>
                    </td>
                    <% if (user && user.role === 'admin') { %>
                    <td>
                      <% if (!isCurrent) { %>
                        <button class="btn btn-sm btn-outline-danger btn-icon"
                          title="حذف المستخدم"
                          onclick="deleteUser('<%= u._id %>', '<%= u.name %>')">
                          <i class="bi bi-trash3"></i>
                        </button>
                      <% } %>
                    </td>
                    <% } %>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% } else { %>
              <div class="app-card-body text-center text-muted py-4">
                <% if (user && user.role !== 'admin') { %>
                  <p class="small mb-0">⚠️ فقط المدير يمكنه عرض قائمة المستخدمين</p>
                <% } else { %>
                  <p class="small mb-0">لا يوجد مستخدمون مسجلون</p>
                <% } %>
              </div>
            <% } %>
          </div>
        </div>

      </div>

    </main>
    <%- include('../partials/footer') %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
<script>
async function toggleUser(id, checkbox) {
  try {
    const res  = await fetch('/settings/users/' + id + '/toggle', {
      method: 'PATCH', headers: { 'Content-Type': 'application/json' },
    });
    const data = await res.json();
    if (!data.success) {
      checkbox.checked = !checkbox.checked;
      alert('❌ ' + data.message);
    }
  } catch {
    checkbox.checked = !checkbox.checked;
    alert('❌ خطأ في الاتصال');
  }
}

async function deleteUser(id, name) {
  if (!confirm('هل أنت متأكد من حذف حساب "' + name + '" نهائياً؟\nلا يمكن التراجع عن هذا الإجراء.')) return;
  const res  = await fetch('/settings/users/' + id, {
    method: 'DELETE', headers: { 'Content-Type': 'application/json' },
  });
  const data = await res.json();
  if (data.success) {
    const row = document.getElementById('user-row-' + id);
    if (row) {
      row.style.transition = 'opacity .3s';
      row.style.opacity    = '0';
      setTimeout(() => row.remove(), 300);
    }
  } else {
    alert('❌ ' + data.message);
  }
}
</script>
</body>
</html>
