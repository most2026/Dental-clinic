<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> | <%= clinicName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="app-wrapper">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/navbar') %>
    <main class="page-content">

      <div class="page-header">
        <div>
          <h1 class="page-title">➕ تسجيل مريض جديد</h1>
          <p class="page-subtitle">أدخل بيانات المريض الأساسية والطبية</p>
        </div>
        <a href="/patients" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-right me-1"></i> العودة للقائمة
        </a>
      </div>

      <%# أخطاء التحقق من المدخلات %>
      <% if (locals.errors && errors.length > 0) { %>
        <div class="flash-alert alert alert-danger alert-dismissible">
          <div>
            <strong>❌ يرجى تصحيح الأخطاء التالية:</strong>
            <ul class="mb-0 mt-1">
              <% errors.forEach(e => { %><li><%= e %></li><% }) %>
            </ul>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <form method="POST" action="/patients" data-loading="true" novalidate>

        <%# البيانات الشخصية %>
        <div class="app-card mb-4">
          <div class="app-card-header">
            <h2 class="app-card-title">👤 البيانات الشخصية</h2>
          </div>
          <div class="app-card-body">
            <div class="row g-3">

              <div class="col-md-4">
                <label class="form-label fw-semibold">الاسم الأول <span class="text-danger">*</span></label>
                <input type="text" name="firstName" class="form-control"
                  placeholder="مثال: أحمد"
                  value="<%= locals.patient ? patient.firstName : '' %>"
                  required maxlength="50"/>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-semibold">اسم العائلة <span class="text-danger">*</span></label>
                <input type="text" name="lastName" class="form-control"
                  placeholder="مثال: الأنصاري"
                  value="<%= locals.patient ? patient.lastName : '' %>"
                  required maxlength="50"/>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-semibold">الجنس <span class="text-danger">*</span></label>
                <select name="gender" class="form-select" required>
                  <option value="">اختر الجنس</option>
                  <option value="male"   <%= (locals.patient && patient.gender === 'male') ? 'selected' : '' %>>👨 ذكر</option>
                  <option value="female" <%= (locals.patient && patient.gender === 'female') ? 'selected' : '' %>>👩 أنثى</option>
                </select>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-semibold">تاريخ الميلاد <span class="text-danger">*</span></label>
                <input type="date" name="dateOfBirth" class="form-control"
                  value="<%= (locals.patient && patient.dateOfBirth) ? new Date(patient.dateOfBirth).toISOString().split('T')[0] : '' %>"
                  max="<%= new Date().toISOString().split('T')[0] %>"
                  required/>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-semibold">رقم الهاتف <span class="text-danger">*</span></label>
                <input type="tel" name="phone" class="form-control"
                  placeholder="07XX XXX XXXX"
                  value="<%= locals.patient ? patient.phone : '' %>"
                  dir="ltr" required/>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-semibold">هاتف احتياطي</label>
                <input type="tel" name="alternativePhone" class="form-control"
                  placeholder="اختياري"
                  value="<%= locals.patient ? patient.alternativePhone : '' %>"
                  dir="ltr"/>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-semibold">البريد الإلكتروني</label>
                <input type="email" name="email" class="form-control"
                  placeholder="example@email.com"
                  value="<%= locals.patient ? patient.email : '' %>"
                  dir="ltr"/>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-semibold">العنوان</label>
                <input type="text" name="address" class="form-control"
                  placeholder="المدينة، الحي..."
                  value="<%= locals.patient ? patient.address : '' %>"/>
              </div>
            </div>
          </div>
        </div>

        <%# السجل الطبي %>
        <div class="app-card mb-4">
          <div class="app-card-header">
            <h2 class="app-card-title">🩺 السجل الطبي</h2>
            <span class="badge bg-secondary-subtle text-secondary">اختياري</span>
          </div>
          <div class="app-card-body">
            <div class="row g-3">
              <div class="col-md-4">
                <label class="form-label fw-semibold">أمراض مزمنة</label>
                <input type="text" name="chronicDiseases" class="form-control"
                  placeholder="سكري، ضغط، ..."
                  value="<%= (locals.patient && patient.medicalHistory && patient.medicalHistory.chronicDiseases) ? patient.medicalHistory.chronicDiseases.join('، ') : '' %>"/>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-semibold">الأدوية الحالية</label>
                <input type="text" name="currentMedications" class="form-control"
                  placeholder="اسبرين، ميتفورمين، ..."
                  value="<%= (locals.patient && patient.medicalHistory && patient.medicalHistory.currentMedications) ? patient.medicalHistory.currentMedications.join('، ') : '' %>"/>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-semibold">الحساسية</label>
                <input type="text" name="allergies" class="form-control"
                  placeholder="بنسلين، لاتكس، ..."
                  value="<%= (locals.patient && patient.medicalHistory && patient.medicalHistory.allergies) ? patient.medicalHistory.allergies.join('، ') : '' %>"/>
              </div>

              <div class="col-12">
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" name="isSmoker" id="isSmoker"
                    <%= (locals.patient && patient.medicalHistory && patient.medicalHistory.isSmoker) ? 'checked' : '' %>/>
                  <label class="form-check-label fw-semibold" for="isSmoker">🚬 المريض مدخن</label>
                </div>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-semibold">ملاحظات طبية</label>
                <textarea name="additionalNotes" class="form-control" rows="3"
                  placeholder="أي معلومات طبية إضافية..."><%= (locals.patient && patient.medicalHistory) ? patient.medicalHistory.additionalNotes : '' %></textarea>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-semibold">ملاحظات عامة</label>
                <textarea name="generalNotes" class="form-control" rows="3"
                  placeholder="ملاحظات الطبيب العامة..."><%= locals.patient ? patient.generalNotes : '' %></textarea>
              </div>
            </div>
          </div>
        </div>

        <div class="d-flex gap-2 justify-content-end">
          <a href="/patients" class="btn btn-outline-secondary">إلغاء</a>
          <button type="submit" class="btn btn-primary px-4">
            <i class="bi bi-person-check-fill me-1"></i> حفظ المريض
          </button>
        </div>
      </form>
    </main>
    <%- include('../partials/footer') %>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
