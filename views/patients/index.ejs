<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> | <%= clinicName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="app-wrapper">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/navbar') %>
    <main class="page-content">

      <% if (locals.successMsg) { %>
        <div class="flash-alert alert alert-success alert-dismissible">✅ <%= successMsg %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
      <% } %>
      <% if (locals.errorMsg) { %>
        <div class="flash-alert alert alert-danger alert-dismissible">❌ <%= errorMsg %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
      <% } %>

      <%# رأس الصفحة %>
      <div class="page-header">
        <div>
          <h1 class="page-title">👥 المرضى</h1>
          <p class="page-subtitle">إجمالي: <strong><%= pagination.totalCount %></strong> مريض</p>
        </div>
        <a href="/patients/new" class="btn btn-primary">
          <i class="bi bi-person-plus-fill me-1"></i> مريض جديد
        </a>
      </div>

      <%# فلاتر البحث %>
      <div class="app-card mb-4">
        <div class="app-card-body">
          <form method="GET" action="/patients" class="row g-2 align-items-end">
            <div class="col-12 col-md-5">
              <label class="form-label small fw-semibold text-muted">بحث</label>
              <input
                type="text"
                name="search"
                class="form-control"
                placeholder="الاسم، الهاتف، أو كود المريض..."
                value="<%= filters.search %>"
                autocomplete="off"
              />
            </div>
            <div class="col-6 col-md-2">
              <label class="form-label small fw-semibold text-muted">الحالة</label>
              <select name="status" class="form-select">
                <option value="">الكل</option>
                <option value="active"   <%= filters.status === 'active'   ? 'selected' : '' %>>نشط</option>
                <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>غير نشط</option>
              </select>
            </div>
            <div class="col-6 col-md-2">
              <label class="form-label small fw-semibold text-muted">الجنس</label>
              <select name="gender" class="form-select">
                <option value="">الكل</option>
                <option value="male"   <%= filters.gender === 'male'   ? 'selected' : '' %>>ذكر</option>
                <option value="female" <%= filters.gender === 'female' ? 'selected' : '' %>>أنثى</option>
              </select>
            </div>
            <div class="col-6 col-md-2">
              <label class="form-label small fw-semibold text-muted">ترتيب</label>
              <select name="sort" class="form-select">
                <option value="-createdAt" <%= filters.sortBy === '-createdAt' ? 'selected':'' %>>الأحدث</option>
                <option value="lastName"   <%= filters.sortBy === 'lastName'   ? 'selected':'' %>>الاسم</option>
                <option value="-lastVisitDate" <%= filters.sortBy === '-lastVisitDate' ? 'selected':'' %>>آخر زيارة</option>
              </select>
            </div>
            <div class="col-6 col-md-1">
              <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search"></i>
              </button>
            </div>
          </form>
        </div>
      </div>

      <%# جدول المرضى %>
      <div class="app-card">
        <div class="app-card-table">
          <% if (patients && patients.length > 0) { %>
          <table class="app-table">
            <thead>
              <tr>
                <th>المريض</th>
                <th>الكود</th>
                <th>الهاتف</th>
                <th>العمر</th>
                <th>الجنس</th>
                <th>آخر زيارة</th>
                <th>الحالة</th>
                <th>الإجراءات</th>
              </tr>
            </thead>
            <tbody>
              <% patients.forEach(p => { 
                const age = p.dateOfBirth ? Math.floor((Date.now() - new Date(p.dateOfBirth)) / 31557600000) : null;
                const lastVisit = p.lastVisitDate ? new Date(p.lastVisitDate).toLocaleDateString('ar-IQ') : '—';
              %>
              <tr>
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <div class="patient-avatar"><%= p.firstName.charAt(0) %></div>
                    <div>
                      <a href="/patients/<%= p._id %>" class="fw-semibold text-decoration-none text-dark">
                        <%= p.firstName %> <%= p.lastName %>
                      </a>
                    </div>
                  </div>
                </td>
                <td><code class="text-primary small"><%= p.patientCode %></code></td>
                <td dir="ltr"><%= p.phone %></td>
                <td><%= age ? age + ' سنة' : '—' %></td>
                <td><%= p.gender === 'male' ? '👨 ذكر' : '👩 أنثى' %></td>
                <td class="text-muted small"><%= lastVisit %></td>
                <td>
                  <span class="status-badge badge-<%= p.status %>">
                    <%= p.status === 'active' ? 'نشط' : 'غير نشط' %>
                  </span>
                </td>
                <td>
                  <div class="d-flex gap-1">
                    <a href="/patients/<%= p._id %>" class="btn btn-sm btn-outline-primary btn-icon" title="عرض الملف">
                      <i class="bi bi-eye"></i>
                    </a>
                    <a href="/patients/<%= p._id %>/edit" class="btn btn-sm btn-outline-secondary btn-icon" title="تعديل">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <button class="btn btn-sm btn-outline-danger btn-icon" title="تعطيل" onclick="deletePatient('<%= p._id %>', '<%= p.firstName %> <%= p.lastName %>')">
                      <i class="bi bi-person-x"></i>
                    </button>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <% } else { %>
            <div class="text-center py-5 text-muted">
              <div style="font-size:3rem; margin-bottom:12px;">👤</div>
              <h5>لا توجد نتائج</h5>
              <p>
                <% if (filters.search) { %>
                  لم يُعثر على مريض بكلمة "<strong><%= filters.search %></strong>"
                <% } else { %>
                  لم يتم تسجيل أي مريض بعد
                <% } %>
              </p>
              <a href="/patients/new" class="btn btn-primary btn-sm">إضافة مريض جديد</a>
            </div>
          <% } %>
        </div>

        <%# ترقيم الصفحات %>
        <% if (pagination.totalPages > 1) { %>
        <div class="app-card-body border-top">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <small class="text-muted">
              عرض <%= ((pagination.currentPage - 1) * pagination.limit) + 1 %> – <%= Math.min(pagination.currentPage * pagination.limit, pagination.totalCount) %> من <%= pagination.totalCount %> مريض
            </small>
            <nav>
              <ul class="pagination pagination-sm mb-0">
                <li class="page-item <%= !pagination.hasPrev ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= pagination.currentPage - 1 %>&search=<%= filters.search %>&status=<%= filters.status %>&gender=<%= filters.gender %>&sort=<%= filters.sortBy %>">السابق</a>
                </li>
                <% for(let i = 1; i <= pagination.totalPages; i++) { %>
                  <% if (i === 1 || i === pagination.totalPages || Math.abs(i - pagination.currentPage) <= 1) { %>
                    <li class="page-item <%= i === pagination.currentPage ? 'active' : '' %>">
                      <a class="page-link" href="?page=<%= i %>&search=<%= filters.search %>&status=<%= filters.status %>&gender=<%= filters.gender %>&sort=<%= filters.sortBy %>"><%= i %></a>
                    </li>
                  <% } else if (Math.abs(i - pagination.currentPage) === 2) { %>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                  <% } %>
                <% } %>
                <li class="page-item <%= !pagination.hasNext ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= pagination.currentPage + 1 %>&search=<%= filters.search %>&status=<%= filters.status %>&gender=<%= filters.gender %>&sort=<%= filters.sortBy %>">التالي</a>
                </li>
              </ul>
            </nav>
          </div>
        </div>
        <% } %>
      </div>

    </main>
    <%- include('../partials/footer') %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
<script>
function deletePatient(id, name) {
  if (!confirm(`هل أنت متأكد من تعطيل سجل "${name}"؟`)) return;
  fetch(`/patients/${id}`, {
    method: 'DELETE',
    headers: { 'Content-Type': 'application/json' }
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) window.location.reload();
    else alert('❌ ' + data.message);
  })
  .catch(() => alert('❌ خطأ في الاتصال'));
}
</script>
</body>
</html>

