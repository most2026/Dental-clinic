<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title><%= title %> | <%= clinicName %></title>

  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"/>

  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>

  <link rel="stylesheet" href="/css/style.css"/>
</head>

<body>

<div class="app-wrapper">

  <%- include('../partials/sidebar') %>

  <div class="main-content">

    <%- include('../partials/navbar') %>

    <main class="page-content">

      <%# رسائل التنبيه %>

      <% if (successMsg) { %>
        <div class="flash-alert alert alert-success alert-dismissible fade show">
          ✅ <%= successMsg %>
          <button type="button"
                  class="btn-close"
                  data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <% if (errorMsg) { %>
        <div class="flash-alert alert alert-danger alert-dismissible fade show">
          ❌ <%= errorMsg %>
          <button type="button"
                  class="btn-close"
                  data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <%# رأس الصفحة %>

      <div class="page-header">

        <div class="d-flex align-items-center gap-3">

          <div class="patient-avatar"
               style="width:48px;height:48px;font-size:20px;">

            <%= patient?.firstName
                  ? patient.firstName.charAt(0)
                  : '?' %>

          </div>

          <div>
            <h1 class="page-title mb-0">
              🩻 أشعة
              <%= patient.firstName %>
              <%= patient.lastName %>
            </h1>

            <p class="page-subtitle mb-0">

              <code class="text-primary">
                <%= patient.patientCode %>
              </code>

              —
              <strong><%= totalCount %></strong>
              صورة أشعة

            </p>
          </div>

        </div>

        <div class="d-flex gap-2 flex-wrap">

          <% if (xrays.length >= 2) { %>
            <a href="/patients/<%= patient._id %>/xrays/compare"
               class="btn btn-outline-info btn-sm">

              <i class="bi bi-layout-split me-1"></i>
              مقارنة

            </a>
          <% } %>

          <a href="/patients/<%= patient._id %>/xrays/upload"
             class="btn btn-primary btn-sm">

            <i class="bi bi-cloud-upload me-1"></i>
            رفع أشعة

          </a>

          <a href="/patients/<%= patient._id %>"
             class="btn btn-outline-secondary btn-sm">

            <i class="bi bi-arrow-right me-1"></i>
            الملف الطبي

          </a>

        </div>

      </div>

      <%# حالة عدم وجود أشعة %>

      <% if (xrays.length === 0) { %>

        <div class="app-card">

          <div class="app-card-body text-center py-5">

            <div style="font-size:5rem; margin-bottom:16px; opacity:.3;">
              🩻
            </div>

            <h4 class="text-muted">
              لا توجد أشعة مسجلة
            </h4>

            <p class="text-muted mb-4">
              لم يتم رفع أي صور أشعة لهذا المريض بعد
            </p>

            <a href="/patients/<%= patient._id %>/xrays/upload"
               class="btn btn-primary">

              <i class="bi bi-cloud-upload me-1"></i>
              رفع أول أشعة

            </a>

          </div>

        </div>

      <% } else { %>

        <%# عرض الأشعة حسب النوع %>

        <% Object.entries(groupedXrays).forEach(([type, typeXrays]) => { %>

          <div class="app-card mb-4">

            <div class="app-card-header">

              <h2 class="app-card-title">

                🩻 <%= xrayTypesLabels[type] || type %>

                <span class="badge bg-secondary-subtle text-secondary ms-2">
                  <%= typeXrays.length %> صورة
                </span>

              </h2>

              <a href="/patients/<%= patient._id %>/xrays/upload"
                 class="btn btn-sm btn-outline-primary">

                + رفع

              </a>

            </div>

            <div class="app-card-body">

              <div class="xray-gallery">

                <% typeXrays.forEach(xray => {

                  const isImage =
                    xray.filepath &&
                    !xray.filepath.endsWith('.pdf');

                  const dateStr =
                    new Date(xray.uploadedAt)
                    .toLocaleDateString('ar-IQ', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric'
                    });

                %>

                <div class="xray-card"
                     id="xray-card-<%= xray._id %>">

                  <%# أزرار الإجراءات %>

                  <div class="xray-actions">

                    <a href="/patients/<%= patient._id %>/xrays/<%= xray._id %>"
                       class="xray-action-btn"
                       style="background:rgba(13,110,253,0.85);"
                       title="عرض كامل">

                      <i class="bi bi-arrows-fullscreen"
                         style="color:white;font-size:12px;"></i>

                    </a>

                    <button class="xray-action-btn"
                            style="background:rgba(220,53,69,0.85);"
                            title="حذف"
                            onclick="deleteXray('<%= patient._id %>', '<%= xray._id %>', this)">

                      <i class="bi bi-trash3"
                         style="color:white;font-size:12px;"></i>

                    </button>

                  </div>

                  <%# المعاينة %>

                  <div class="xray-thumb"
                       onclick="openLightbox('<%= xray.filepath %>')">

                    <% if (isImage) { %>

                      <img src="<%= xray.filepath %>"
                           alt="أشعة"
                           loading="lazy"
                           onerror="this.parentNode.innerHTML='<div class=\'xray-pdf-icon\'>🩻</div>'"/>

                    <% } else { %>

                      <div class="xray-pdf-icon">
                        📄
                      </div>

                    <% } %>

                  </div>

                  <%# المعلومات %>

                  <div class="xray-info">

                    <div class="xray-type-badge">
                      <%= xrayTypesLabels[xray.xrayType] || xray.xrayType %>
                    </div>

                    <div class="xray-date">
                      📅 <%= dateStr %>
                    </div>

                    <% if (xray.relatedTeeth?.length > 0) { %>

                      <div class="mt-1">

                        <% xray.relatedTeeth.forEach(t => { %>

                          <span class="badge bg-light text-dark border"
                                style="font-size:9px;">

                            🦷 <%= t %>

                          </span>

                        <% }) %>

                      </div>

                    <% } %>

                    <% if (xray.doctorNotes) { %>

                      <p class="small text-muted mt-1 mb-0"
                         style="
                           font-size:11px;
                           line-height:1.4;
                           display:-webkit-box;
                           line-clamp:2;
                           -webkit-line-clamp:2;
                           -webkit-box-orient:vertical;
                           overflow:hidden;
                         ">

                        <%= xray.doctorNotes %>

                      </p>

                    <% } %>

                    <div class="mt-2">

                      <a href="/patients/<%= patient._id %>/xrays/<%= xray._id %>"
                         class="btn btn-outline-primary btn-sm w-100"
                         style="font-size:12px;">

                        عرض التفاصيل

                      </a>

                    </div>

                  </div>

                </div>

                <% }) %>

              </div>

            </div>

          </div>

        <% }) %>

      <% } %>

    </main>

    <%- include('../partials/footer') %>

  </div>

</div>

<%# Lightbox %>

<div class="lightbox-overlay"
     id="lightbox"
     style="display:none;"
     onclick="closeLightbox(event)">

  <img class="lightbox-image"
       id="lightboxImg"
       src=""
       alt="أشعة"/>

  <div class="lightbox-controls"
       onclick="event.stopPropagation()">

    <button class="lightbox-btn"
            onclick="adjustBrightness(-10)">
      🔅 تعتيم
    </button>

    <button class="lightbox-btn"
            onclick="adjustBrightness(10)">
      🔆 إضاءة
    </button>

    <button class="lightbox-btn"
            onclick="adjustContrast(10)">
      ◑ تباين+
    </button>

    <button class="lightbox-btn"
            onclick="rotateImage()">
      🔄 تدوير
    </button>

    <button class="lightbox-btn"
            onclick="resetFilters()">
      ↺ إعادة تعيين
    </button>

    <button class="lightbox-btn"
            onclick="closeLightbox()">
      ✕ إغلاق
    </button>

  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="/js/main.js"></script>

<script>

let brightness = 100;
let contrast   = 100;
let rotation   = 0;

const lightbox    = document.getElementById('lightbox');
const lightboxImg = document.getElementById('lightboxImg');

function openLightbox(src) {

  if (!src) return;

  if (src.endsWith('.pdf')) {
    window.open(src, '_blank');
    return;
  }

  resetFilters(false);

  lightboxImg.src = src;

  lightbox.style.display = 'flex';

  document.body.style.overflow = 'hidden';
}

function closeLightbox(e) {

  if (e && e.target !== lightbox) return;

  lightbox.style.display = 'none';

  document.body.style.overflow = '';

  lightboxImg.src = '';
}

function applyFilters() {

  lightboxImg.style.filter =
    `brightness(${brightness}%) contrast(${contrast}%)`;

  lightboxImg.style.transform =
    `rotate(${rotation}deg)`;
}

function adjustBrightness(delta) {

  brightness = Math.max(
    20,
    Math.min(200, brightness + delta)
  );

  applyFilters();
}

function adjustContrast(delta) {

  contrast = Math.max(
    50,
    Math.min(300, contrast + delta)
  );

  applyFilters();
}

function rotateImage() {

  rotation = (rotation + 90) % 360;

  applyFilters();
}

function resetFilters(apply = true) {

  brightness = 100;
  contrast   = 100;
  rotation   = 0;

  if (apply) applyFilters();
}

document.addEventListener('keydown', e => {

  if (lightbox.style.display !== 'flex') return;

  if (e.key === 'Escape') {
    closeLightbox();
  }

  if (e.key === 'ArrowRight') {
    adjustBrightness(10);
  }

  if (e.key === 'ArrowLeft') {
    adjustBrightness(-10);
  }

  if (e.key.toLowerCase() === 'r') {
    rotateImage();
  }

});

async function deleteXray(patientId, xrayId, btn) {

  const confirmed = confirm(
    'هل أنت متأكد من حذف هذه الصورة؟ لا يمكن التراجع.'
  );

  if (!confirmed) return;

  try {

    btn.disabled = true;

    btn.innerHTML = '⏳';

    const res = await fetch(
      `/patients/${patientId}/xrays/${xrayId}`,
      {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json'
        }
      }
    );

    const data = await res.json();

    if (!data.success) {
      throw new Error(data.message);
    }

    const card =
      document.getElementById(`xray-card-${xrayId}`);

    if (card) {

      card.style.transition = 'all .3s';

      card.style.opacity = '0';

      card.style.transform = 'scale(.8)';

      setTimeout(() => {
        card.remove();
      }, 300);
    }

  } catch (err) {

    alert('❌ ' + err.message);

    btn.disabled = false;

    btn.innerHTML = `
      <i class="bi bi-trash3"
         style="color:white;font-size:12px;"></i>
    `;
  }
}

</script>

</body>
</html>

