<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

  <meta charset="UTF-8" />

  <meta name="viewport"
        content="width=device-width, initial-scale=1.0" />

  <title>
    <%= title %> | <%= clinicName %>
  </title>

  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />

  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

  <link rel="stylesheet"
        href="/css/style.css" />

</head>

<body>

<div class="app-wrapper">

  <%- include('../partials/sidebar') %>

  <div class="main-content">

    <%- include('../partials/navbar') %>

    <main class="page-content">

      <div class="page-header">

        <div>

          <h1 class="page-title">
            ⚖️ مقارنة الأشعة
          </h1>

          <p class="page-subtitle">

            <%= patient.firstName %>
            <%= patient.lastName %>

            — قارن صورتين جنباً إلى جنب

          </p>

        </div>

        <a href="/patients/<%= patient._id %>/xrays"
           class="btn btn-outline-secondary btn-sm">

          <i class="bi bi-arrow-right me-1"></i>
          المعرض

        </a>

      </div>

      <%# اختيار الأشعتين %>

      <div class="app-card mb-4">

        <div class="app-card-body">

          <form method="GET"
                action="/patients/<%= patient._id %>/xrays/compare"
                class="row g-3 align-items-end">

            <div class="col-12 col-md-5">

              <label class="form-label fw-semibold">
                الأشعة الأولى (يمين)
              </label>

              <select name="xray1"
                      class="form-select">

                <option value="">
                  اختر أشعة...
                </option>

                <% allXrays.forEach(x => { %>

                  <option value="<%= x._id %>"
                    <%= firstXray?._id?.toString() === x._id?.toString()
                      ? 'selected'
                      : '' %>>

                    <%= xrayTypesLabels[x.xrayType] %>

                    —

                    <%= new Date(x.uploadedAt)
                          .toLocaleDateString('ar-IQ') %>

                  </option>

                <% }) %>

              </select>

            </div>

            <div class="col-12 col-md-5">

              <label class="form-label fw-semibold">
                الأشعة الثانية (يسار)
              </label>

              <select name="xray2"
                      class="form-select">

                <option value="">
                  اختر أشعة...
                </option>

                <% allXrays.forEach(x => { %>

                  <option value="<%= x._id %>"
                    <%= secondXray?._id?.toString() === x._id?.toString()
                      ? 'selected'
                      : '' %>>

                    <%= xrayTypesLabels[x.xrayType] %>

                    —

                    <%= new Date(x.uploadedAt)
                          .toLocaleDateString('ar-IQ') %>

                  </option>

                <% }) %>

              </select>

            </div>

            <div class="col-12 col-md-2">

              <button type="submit"
                      class="btn btn-primary w-100">

                <i class="bi bi-layout-split me-1"></i>
                مقارنة

              </button>

            </div>

          </form>

        </div>

      </div>

      <%# أدوات المقارنة %>

      <div class="app-card mb-3"
           style="background:#1a1f36;">

        <div class="app-card-body py-2">

          <div class="xray-tools justify-content-center">

            <button class="tool-btn"
                    onclick="syncBrightness(-15)">

              🔅 تعتيم الكل

            </button>

            <button class="tool-btn"
                    onclick="syncBrightness(15)">

              🔆 إضاءة الكل

            </button>

            <button class="tool-btn"
                    onclick="syncContrast(10)">

              ◑ تباين+

            </button>

            <button class="tool-btn"
                    onclick="syncContrast(-10)">

              ◑ تباين−

            </button>

            <button class="tool-btn"
                    onclick="syncInvert()">

              ⬛ عكس الكل

            </button>

            <button class="tool-btn"
                    onclick="syncReset()">

              ↺ إعادة تعيين

            </button>

          </div>

        </div>

      </div>

      <%# لوحة المقارنة %>

      <div class="row g-3">

        <%# الأشعة الأولى %>

        <div class="col-12 col-md-6">

          <div class="app-card"
               style="background:#0f1117;">

            <div class="app-card-body py-2"
                 style="border-bottom:1px solid rgba(255,255,255,.1);">

              <div class="text-white text-center small fw-semibold">

                🩻 الأشعة الأولى

                <% if (firstXray) { %>

                  —

                  <%= xrayTypesLabels[firstXray.xrayType] %>

                  —

                  <%= new Date(firstXray.uploadedAt)
                        .toLocaleDateString('ar-IQ') %>

                <% } %>

              </div>

            </div>

            <div class="compare-panel"
                 style="
                  min-height:380px;
                  display:flex;
                  align-items:center;
                  justify-content:center;
                  overflow:hidden;
                 ">

              <% if (
                firstXray &&
                firstXray.filepath &&
                !firstXray.filepath.endsWith('.pdf')
              ) { %>

                <img id="img1"
                     src="<%= firstXray.filepath %>"
                     alt="الأشعة الأولى"
                     draggable="false"
                     style="
                      max-width:100%;
                      max-height:380px;
                      object-fit:contain;
                      transition:filter .2s, transform .2s;
                     " />

              <% } else if (firstXray) { %>

                <div class="compare-empty">

                  <div style="font-size:3rem;">
                    📄
                  </div>

                  <p>ملف PDF</p>

                </div>

              <% } else { %>

                <div class="compare-empty">

                  <div style="font-size:3rem;">
                    🩻
                  </div>

                  <p>اختر الأشعة الأولى</p>

                </div>

              <% } %>

            </div>

            <% if (firstXray?.doctorNotes) { %>

              <div class="p-3"
                   style="border-top:1px solid rgba(255,255,255,.1);">

                <p class="text-white small mb-0"
                   style="opacity:.7;">

                  📝 <%= firstXray.doctorNotes %>

                </p>

              </div>

            <% } %>

          </div>

        </div>

        <%# الأشعة الثانية %>

        <div class="col-12 col-md-6">

          <div class="app-card"
               style="background:#0f1117;">

            <div class="app-card-body py-2"
                 style="border-bottom:1px solid rgba(255,255,255,.1);">

              <div class="text-white text-center small fw-semibold">

                🩻 الأشعة الثانية

                <% if (secondXray) { %>

                  —

                  <%= xrayTypesLabels[secondXray.xrayType] %>

                  —

                  <%= new Date(secondXray.uploadedAt)
                        .toLocaleDateString('ar-IQ') %>

                <% } %>

              </div>

            </div>

            <div class="compare-panel"
                 style="
                  min-height:380px;
                  display:flex;
                  align-items:center;
                  justify-content:center;
                  overflow:hidden;
                 ">

              <% if (
                secondXray &&
                secondXray.filepath &&
                !secondXray.filepath.endsWith('.pdf')
              ) { %>

                <img id="img2"
                     src="<%= secondXray.filepath %>"
                     alt="الأشعة الثانية"
                     draggable="false"
                     style="
                      max-width:100%;
                      max-height:380px;
                      object-fit:contain;
                      transition:filter .2s, transform .2s;
                     " />

              <% } else if (secondXray) { %>

                <div class="compare-empty">

                  <div style="font-size:3rem;">
                    📄
                  </div>

                  <p>ملف PDF</p>

                </div>

              <% } else { %>

                <div class="compare-empty">

                  <div style="font-size:3rem;">
                    🩻
                  </div>

                  <p>اختر الأشعة الثانية</p>

                </div>

              <% } %>

            </div>

            <% if (secondXray?.doctorNotes) { %>

              <div class="p-3"
                   style="border-top:1px solid rgba(255,255,255,.1);">

                <p class="text-white small mb-0"
                   style="opacity:.7;">

                  📝 <%= secondXray.doctorNotes %>

                </p>

              </div>

            <% } %>

          </div>

        </div>

      </div>

    </main>

    <%- include('../partials/footer') %>

  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="/js/main.js"></script>

<script>

const img1 = document.getElementById('img1');
const img2 = document.getElementById('img2');

let brightness = 100;
let contrast   = 100;
let inverted   = false;
let scale      = 1;

function applyFilters() {

  const filterValue = `
    brightness(${brightness}%)
    contrast(${contrast}%)
    invert(${inverted ? 100 : 0}%)
  `;

  const transformValue =
    `scale(${scale})`;

  if (img1) {

    img1.style.filter = filterValue;

    img1.style.transform = transformValue;
  }

  if (img2) {

    img2.style.filter = filterValue;

    img2.style.transform = transformValue;
  }
}

function syncBrightness(delta) {

  brightness = Math.max(
    10,
    Math.min(300, brightness + delta)
  );

  applyFilters();
}

function syncContrast(delta) {

  contrast = Math.max(
    50,
    Math.min(400, contrast + delta)
  );

  applyFilters();
}

function syncInvert() {

  inverted = !inverted;

  applyFilters();
}

function syncReset() {

  brightness = 100;

  contrast = 100;

  inverted = false;

  scale = 1;

  applyFilters();
}

function zoomImages(delta) {

  scale = Math.max(
    0.5,
    Math.min(4, scale + delta)
  );

  applyFilters();
}

[img1, img2].forEach(img => {

  img?.addEventListener('wheel', e => {

    e.preventDefault();

    if (e.deltaY < 0) {

      zoomImages(0.1);

    } else {

      zoomImages(-0.1);

    }

  });

});

</script>

</body>
</html>
