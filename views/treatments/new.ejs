<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> | <%= clinicName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="app-wrapper">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/navbar') %>
    <main class="page-content">

      <div class="page-header">
        <div>
          <h1 class="page-title">➕ إضافة علاج جديد</h1>
          <p class="page-subtitle">أضف خدمة جديدة لكتالوج العيادة</p>
        </div>
        <a href="/treatments" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-right me-1"></i> العودة
        </a>
      </div>

      <% if (errors && errors.length > 0) { %>
        <div class="flash-alert alert alert-danger alert-dismissible">
          ❌ <%= errors[0] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
          <form method="POST" action="/treatments" data-loading="true" novalidate>
            <div class="app-card">
              <div class="app-card-header">
                <h2 class="app-card-title">🩺 بيانات العلاج</h2>
              </div>
              <div class="app-card-body">
                <div class="row g-3">

                  <div class="col-md-6">
                    <label class="form-label fw-semibold">
                      اسم العلاج بالعربي <span class="text-danger">*</span>
                    </label>
                    <input type="text" name="nameAr" class="form-control"
                      value="<%= treatment.nameAr || '' %>"
                      placeholder="مثال: حشو ضرسي" required maxlength="100"/>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-semibold">اسم العلاج بالإنجليزي</label>
                    <input type="text" name="nameEn" class="form-control"
                      value="<%= treatment.nameEn || '' %>"
                      placeholder="Dental Filling" dir="ltr" maxlength="100"/>
                  </div>

                  <div class="col-md-4">
                    <label class="form-label fw-semibold">
                      الكود <span class="text-danger">*</span>
                    </label>
                    <input type="text" name="code" class="form-control"
                      value="<%= treatment.code || '' %>"
                      placeholder="FILL-01" dir="ltr" required
                      style="text-transform:uppercase;"
                      oninput="this.value=this.value.toUpperCase()"/>
                    <div class="form-text">كود فريد مختصر للخدمة</div>
                  </div>

                  <div class="col-md-4">
                    <label class="form-label fw-semibold">
                      التصنيف <span class="text-danger">*</span>
                    </label>
                    <select name="category" class="form-select" required>
                      <option value="">اختر التصنيف</option>
                      <% Object.entries(categoryLabels).forEach(function([val, label]) { %>
                        <option value="<%= val %>"
                          <%= treatment.category === val ? 'selected' : '' %>>
                          <%= label %>
                        </option>
                      <% }) %>
                    </select>
                  </div>

                  <div class="col-md-4">
                    <label class="form-label fw-semibold">
                      المدة الافتراضية (دقيقة)
                    </label>
                    <input type="number" name="defaultDuration" class="form-control"
                      value="<%= treatment.defaultDuration || 30 %>"
                      min="5" max="480" placeholder="30"/>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-semibold">
                      السعر الافتراضي <span class="text-danger">*</span>
                    </label>
                    <input type="number" name="defaultPrice" class="form-control"
                      value="<%= treatment.defaultPrice || '' %>"
                      min="0" step="500" placeholder="0" required dir="ltr"/>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-semibold">العملة</label>
                    <select name="currency" class="form-select">
                      <option value="IQD" <%= treatment.currency==='IQD'?'selected':'' %>>دينار عراقي (IQD)</option>
                      <option value="USD" <%= treatment.currency==='USD'?'selected':'' %>>دولار أمريكي (USD)</option>
                      <option value="SAR" <%= treatment.currency==='SAR'?'selected':'' %>>ريال سعودي (SAR)</option>
                      <option value="AED" <%= treatment.currency==='AED'?'selected':'' %>>درهم إماراتي (AED)</option>
                    </select>
                  </div>

                  <div class="col-12">
                    <label class="form-label fw-semibold">وصف الخدمة</label>
                    <textarea name="description" class="form-control" rows="3"
                      placeholder="وصف مختصر للعلاج وما يشمله..."><%= treatment.description || '' %></textarea>
                  </div>

                </div>
              </div>
              <div class="app-card-body border-top d-flex justify-content-end gap-2">
                <a href="/treatments" class="btn btn-outline-secondary">إلغاء</a>
                <button type="submit" class="btn btn-primary px-4">
                  <i class="bi bi-check-circle-fill me-1"></i> حفظ العلاج
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

    </main>
    <%- include('../partials/footer') %>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
