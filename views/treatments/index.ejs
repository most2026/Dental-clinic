<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> | <%= clinicName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="app-wrapper">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/navbar') %>
    <main class="page-content">

      <% if (successMsg) { %>
        <div class="flash-alert alert alert-success alert-dismissible">
          ✅ <%= successMsg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>
      <% if (errorMsg) { %>
        <div class="flash-alert alert alert-danger alert-dismissible">
          ❌ <%= errorMsg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <div class="page-header">
        <div>
          <h1 class="page-title">🩺 كتالوج العلاجات</h1>
          <p class="page-subtitle">إجمالي: <strong><%= totalCount %></strong> علاج</p>
        </div>
        <a href="/treatments/new" class="btn btn-primary">
          <i class="bi bi-plus-circle me-1"></i> علاج جديد
        </a>
      </div>

      <%# فلاتر البحث %>
      <div class="app-card mb-4">
        <div class="app-card-body">
          <form method="GET" action="/treatments" class="row g-2 align-items-end">
            <div class="col-12 col-md-5">
              <label class="form-label small fw-semibold text-muted">بحث</label>
              <input type="text" name="search" class="form-control"
                placeholder="اسم العلاج أو الكود..."
                value="<%= filters.search %>"/>
            </div>
            <div class="col-6 col-md-4">
              <label class="form-label small fw-semibold text-muted">التصنيف</label>
              <select name="category" class="form-select">
                <option value="">الكل</option>
                <% Object.entries(categoryLabels).forEach(function([val, label]) { %>
                  <option value="<%= val %>"
                    <%= filters.category === val ? 'selected' : '' %>>
                    <%= label %>
                  </option>
                <% }) %>
              </select>
            </div>
            <div class="col-6 col-md-3 d-flex gap-2">
              <button type="submit" class="btn btn-primary flex-grow-1">
                <i class="bi bi-search"></i>
              </button>
              <a href="/treatments" class="btn btn-outline-secondary flex-grow-1">مسح</a>
            </div>
          </form>
        </div>
      </div>

      <%# العرض حسب التصنيف %>
      <% if (treatments.length === 0) { %>
        <div class="app-card">
          <div class="app-card-body text-center py-5 text-muted">
            <div style="font-size:3rem; margin-bottom:12px;">🩺</div>
            <h5>لا توجد علاجات مسجلة</h5>
            <a href="/treatments/new" class="btn btn-primary btn-sm mt-2">
              إضافة أول علاج
            </a>
          </div>
        </div>
      <% } else { %>
        <% Object.entries(grouped).forEach(function([cat, catTreatments]) { %>
          <div class="app-card mb-3">
            <div class="app-card-header">
              <h2 class="app-card-title">
                🏷️ <%= categoryLabels[cat] || cat %>
                <span class="badge bg-secondary-subtle text-secondary ms-2">
                  <%= catTreatments.length %>
                </span>
              </h2>
            </div>
            <div class="app-card-table">
              <table class="app-table">
                <thead>
                  <tr>
                    <th>اسم العلاج</th>
                    <th>الكود</th>
                    <th>السعر الافتراضي</th>
                    <th>المدة (دقيقة)</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                  </tr>
                </thead>
                <tbody>
                  <% catTreatments.forEach(function(t) { %>
                  <tr id="treatment-row-<%= t._id %>">
                    <td>
                      <div class="fw-semibold"><%= t.nameAr %></div>
                      <% if (t.nameEn) { %>
                        <small class="text-muted" dir="ltr"><%= t.nameEn %></small>
                      <% } %>
                      <% if (t.description) { %>
                        <div class="text-muted small mt-1"
                             style="max-width:300px; white-space:nowrap;
                                    overflow:hidden; text-overflow:ellipsis;">
                          <%= t.description %>
                        </div>
                      <% } %>
                    </td>
                    <td>
                      <code class="text-primary"><%= t.code %></code>
                    </td>
                    <td class="fw-semibold">
                      <%= t.defaultPrice.toLocaleString('ar-IQ') %>
                      <small class="text-muted"><%= t.currency %></small>
                    </td>
                    <td class="text-muted"><%= t.defaultDuration %> د</td>
                    <td>
                      <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox"
                          <%= t.isActive ? 'checked' : '' %>
                          onchange="toggleTreatment('<%= t._id %>', this)"
                          title="<%= t.isActive ? 'نشط — انقر لتعطيل' : 'معطّل — انقر لتفعيل' %>"/>
                      </div>
                    </td>
                    <td>
                      <div class="d-flex gap-1">
                        <a href="/treatments/<%= t._id %>/edit"
                           class="btn btn-sm btn-outline-primary btn-icon" title="تعديل">
                          <i class="bi bi-pencil"></i>
                        </a>
                        <button class="btn btn-sm btn-outline-danger btn-icon" title="حذف"
                          onclick="deleteTreatment('<%= t._id %>', '<%= t.nameAr %>')">
                          <i class="bi bi-trash3"></i>
                        </button>
                      </div>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        <% }) %>
      <% } %>

    </main>
    <%- include('../partials/footer') %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
<script>
async function toggleTreatment(id, checkbox) {
  try {
    const res  = await fetch('/treatments/' + id + '/toggle', {
      method: 'PATCH', headers: { 'Content-Type': 'application/json' },
    });
    const data = await res.json();
    if (!data.success) {
      checkbox.checked = !checkbox.checked;
      alert('❌ ' + data.message);
    }
  } catch {
    checkbox.checked = !checkbox.checked;
    alert('❌ خطأ في الاتصال');
  }
}

async function deleteTreatment(id, name) {
  if (!confirm('هل تريد تعطيل العلاج "' + name + '"؟')) return;
  const res  = await fetch('/treatments/' + id, {
    method: 'DELETE', headers: { 'Content-Type': 'application/json' },
  });
  const data = await res.json();
  if (data.success) {
    const row = document.getElementById('treatment-row-' + id);
    if (row) {
      row.style.opacity    = '0';
      row.style.transition = 'opacity .3s';
      setTimeout(() => row.remove(), 300);
    }
  } else {
    alert('❌ ' + data.message);
  }
}
</script>
</body>
</html>
