<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title><%= title %> | <%= clinicName %></title>

  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"/>

  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>

  <link rel="stylesheet" href="/css/style.css"/>

  <style>
    .status-badge{
      padding:.5em 1em;
      border-radius:50px;
      font-size:.85rem;
      font-weight:600;
    }

    .badge-paid{
      background:#dcfce7;
      color:#166534;
    }

    .badge-partial{
      background:#fef9c3;
      color:#854d0e;
    }

    .badge-unpaid{
      background:#fee2e2;
      color:#991b1b;
    }

    .badge-cancelled{
      background:#f3f4f6;
      color:#374151;
    }

    .tooth-badge{
      background:#f8fafc;
      border:1px solid #e2e8f0;
      color:#475569;
      padding:2px 8px;
      border-radius:6px;
      font-size:11px;
      font-weight:bold;
    }

    .payment-row:hover{
      background:#f8f9fa;
    }

    .sticky-sidebar{
      position:sticky;
      top:20px;
    }
  </style>
</head>

<body>

<div class="app-wrapper">

  <%- include('../partials/sidebar') %>

  <div class="main-content">

    <%- include('../partials/navbar') %>

    <main class="page-content">

      <div class="page-header d-flex justify-content-between align-items-center mb-4">

        <div>

          <div class="d-flex align-items-center gap-2 mb-1">

            <h1 class="page-title h3 mb-0">
              🧾 <%= invoice.invoiceNumber %>
            </h1>

            <span class="status-badge badge-<%= invoice.status %>">
              <%= statusLabels[invoice.status] %>
            </span>

          </div>

          <p class="text-muted small">
            <i class="bi bi-calendar3 me-1"></i>

            <%= new Date(invoice.createdAt).toLocaleDateString(
              'ar-IQ',
              {
                weekday:'long',
                year:'numeric',
                month:'long',
                day:'numeric'
              }
            ) %>
          </p>

        </div>

        <div class="d-flex gap-2">

          <a href="/invoices/<%= invoice._id %>/print"
             target="_blank"
             class="btn btn-light border shadow-sm">

            <i class="bi bi-printer me-1"></i>
            طباعة

          </a>

          <a href="/invoices"
             class="btn btn-outline-secondary">

            <i class="bi bi-arrow-right me-1"></i>
            العودة

          </a>

        </div>

      </div>

      <!-- جدول الخدمات -->

      <div class="app-card border shadow-sm mb-4">

        <div class="app-card-header bg-light p-3">
          <h2 class="h6 mb-0 fw-bold">📋 خدمات الفاتورة</h2>
        </div>

        <div class="table-responsive">

          <table class="table align-middle mb-0">

            <thead class="table-light">

              <tr class="small text-muted">
                <th class="ps-3">الخدمة</th>
                <th>الأسنان</th>
                <th>السعر</th>
                <th>الكمية</th>
                <th>الخصم</th>
                <th class="text-end pe-3">الإجمالي</th>
              </tr>

            </thead>

            <tbody>

            <% invoice.items.forEach(item => { %>

              <tr>

                <td class="ps-3">
                  <div class="fw-semibold">
                    <%= item.description %>
                  </div>
                </td>

                <td>

                  <% if (item.relatedTeeth && item.relatedTeeth.length > 0) { %>

                    <div class="d-flex gap-1 flex-wrap">

                      <% item.relatedTeeth.forEach(t => { %>

                        <span class="tooth-badge">
                          <%= t %>
                        </span>

                      <% }) %>

                    </div>

                  <% } else { %>

                    <span class="text-muted">—</span>

                  <% } %>

                </td>

                <td>
                  <%= item.unitPrice.toLocaleString('ar-IQ') %>
                </td>

                <td>
                  <span class="badge bg-light text-dark border">
                    <%= item.quantity %>
                  </span>
                </td>

                <td>

                  <% if (item.discount > 0) { %>

                    <span class="text-danger">
                      -<%= item.discount %>%
                    </span>

                  <% } else { %>

                    —
                  
                  <% } %>

                </td>

                <td class="text-end pe-3 fw-bold">

                  <%= item.subtotal.toLocaleString('ar-IQ') %>

                </td>

              </tr>

            <% }) %>

            </tbody>

          </table>

        </div>

      </div>

      <!-- حالة الدفع -->

      <%
        const progress = invoice.paymentProgress || 0;

        let progressClass = 'bg-danger';

        if(progress >= 100){
          progressClass = 'bg-success';
        }else if(progress > 50){
          progressClass = 'bg-warning';
        }

        let badgeClass = 'danger';

        if(progress >= 100){
          badgeClass = 'success';
        }else if(progress > 0){
          badgeClass = 'warning';
        }
      %>

      <div class="app-card border-0 shadow-sm p-4"
           style="background:#1e293b;color:#fff;border-radius:16px;">

        <div class="d-flex justify-content-between align-items-center mb-2">

          <span class="small opacity-75">
            حالة التحصيل
          </span>

          <span class="badge bg-<%= badgeClass %>">
            <%= progress %>%
          </span>

        </div>

        <div class="progress mb-4"
             style="height:10px;background:rgba(255,255,255,.1);">

          
        </div>

        <div class="d-flex justify-content-between mb-2">

          <span>إجمالي الفاتورة</span>

          <span>
            <%= invoice.totalAmount.toLocaleString('ar-IQ') %> د.ع
          </span>

        </div>

        <div class="d-flex justify-content-between mb-2 text-success">

          <span>المبلغ المدفوع</span>

          <span>
            <%= invoice.paidAmount.toLocaleString('ar-IQ') %> د.ع
          </span>

        </div>

        <hr>

        <div class="d-flex justify-content-between">

          <span class="text-warning fw-bold">
            المتبقي
          </span>

          <span class="fw-bold text-warning">

            <%= invoice.remainingAmount.toLocaleString('ar-IQ') %> د.ع

          </span>

        </div>

      </div>

    </main>

    <%- include('../partials/footer') %>

  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
