<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> | <%= clinicName %></title>
  
  <!-- CSS Links -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="app-wrapper">
  <%- include('../partials/sidebar') %>
  
  <div class="main-content">
    <%- include('../partials/navbar') %>
    
    <main class="page-content">

      <%# رسائل التنبيه (Flash Messages) %>
      <% if (successMsg && successMsg.length > 0) { %>
        <div class="flash-alert alert alert-success alert-dismissible fade show">
          <i class="bi bi-check-circle-fill me-2"></i> <%= successMsg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <% if (errorMsg && errorMsg.length > 0) { %>
        <div class="flash-alert alert alert-danger alert-dismissible fade show">
          <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= errorMsg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="page-title h3 mb-1">🧾 الفواتير</h1>
          <p class="page-subtitle text-muted">إجمالي الفواتير: <strong><%= pagination.totalCount %></strong></p>
        </div>
        <a href="/invoices/new" class="btn btn-primary">
          <i class="bi bi-plus-circle me-1"></i> فاتورة جديدة
        </a>
      </div>

      <%# بطاقات الملخص المالي %>
      <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
          <div class="stat-card p-3 border rounded shadow-sm bg-white">
            <div class="d-flex align-items-center">
              <div class="stat-card-icon p-3 rounded-circle me-3" style="background:#e8f0fe; font-size: 1.5rem;">💰</div>
              <div>
                <div class="stat-card-value h4 mb-0"><%= (summary.totalAmount || 0).toLocaleString('ar-IQ') %></div>
                <div class="stat-card-label text-muted small">إجمالي الفواتير (د.ع)</div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="stat-card p-3 border rounded shadow-sm bg-white">
            <div class="d-flex align-items-center">
              <div class="stat-card-icon p-3 rounded-circle me-3" style="background:#dcfce7; font-size: 1.5rem;">✅</div>
              <div>
                <div class="stat-card-value h4 mb-0 text-success"><%= (summary.totalPaid || 0).toLocaleString('ar-IQ') %></div>
                <div class="stat-card-label text-muted small">إجمالي المحصّل (د.ع)</div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="stat-card p-3 border rounded shadow-sm bg-white">
            <div class="d-flex align-items-center">
              <div class="stat-card-icon p-3 rounded-circle me-3" style="background:#fee2e2; font-size: 1.5rem;">⏳</div>
              <div>
                <div class="stat-card-value h4 mb-0 text-danger"><%= (summary.totalPending || 0).toLocaleString('ar-IQ') %></div>
                <div class="stat-card-label text-muted small">إجمالي المتبقي (د.ع)</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%# فلاتر البحث %>
      <div class="app-card mb-4 border rounded bg-light p-3">
        <form method="GET" action="/invoices" class="row g-3 align-items-end">
          <div class="col-12 col-md-3">
            <label class="form-label small fw-bold">رقم الفاتورة</label>
            <input type="text" name="search" class="form-control" placeholder="INV-..." value="<%= filters.search || '' %>" dir="ltr"/>
          </div>
          <div class="col-6 col-md-2">
            <label class="form-label small fw-bold">الحالة</label>
            <select name="status" class="form-select">
              <option value="">الكل</option>
              <% Object.entries(statusLabels).forEach(([val, label]) => { %>
                <option value="<%= val %>" <%= filters.status === val ? 'selected' : '' %>><%= label %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-6 col-md-2">
            <label class="form-label small fw-bold">من تاريخ</label>
            <input type="date" name="dateFrom" class="form-control" value="<%= filters.dateFrom || '' %>"/>
          </div>
          <div class="col-6 col-md-2">
            <label class="form-label small fw-bold">إلى تاريخ</label>
            <input type="date" name="dateTo" class="form-control" value="<%= filters.dateTo || '' %>"/>
          </div>
          <div class="col-6 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i> بحث</button>
            <a href="/invoices" class="btn btn-outline-secondary">مسح</a>
          </div>
        </form>
      </div>

      <%# الجدول %>
      <div class="app-card border rounded shadow-sm bg-white overflow-hidden">
        <div class="table-responsive">
          <% if (invoices && invoices.length > 0) { %>
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">رقم الفاتورة</th>
                <th>المريض</th>
                <th>التاريخ</th>
                <th>الإجمالي</th>
                <th>المدفوع</th>
                <th>المتبقي</th>
                <th>نسبة السداد</th>
                <th>الحالة</th>
                <th class="text-center">الإجراءات</th>
              </tr>
            </thead>
            <tbody>
              <% invoices.forEach(inv => { 
                const total = inv.totalAmount || 0;
                const paid = inv.paidAmount || 0;
                const progress = total > 0 ? Math.min(100, Math.round((paid / total) * 100)) : 0;
              %>
              <tr>
                <td class="ps-3">
                  <a href="/invoices/<%= inv._id %>" class="fw-bold text-primary text-decoration-none">
                    <%= inv.invoiceNumber %>
                  </a>
                </td>
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <div class="avatar bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center" style="width:32px; height:32px; font-size:12px;">
                      <%= inv.patient?.firstName ? inv.patient.firstName.charAt(0) : '؟' %>
                    </div>
                    <div>
                      <div class="small fw-bold text-dark">
                        <%= inv.patient?.firstName || 'غير' %> <%= inv.patient?.lastName || 'معروف' %>
                      </div>
                      <small class="text-muted"><%= inv.patient?.patientCode || '-' %></small>
                    </div>
                  </div>
                </td>
                <td class="small text-muted">
                  <%= new Date(inv.createdAt).toLocaleDateString('ar-IQ', { day:'numeric', month:'short', year:'numeric' }) %>
                </td>
                <td class="fw-bold"><%= total.toLocaleString('ar-IQ') %></td>
                <td class="text-success fw-semibold"><%= paid.toLocaleString('ar-IQ') %></td>
                <td class="<%= (inv.remainingAmount > 0) ? 'text-danger fw-bold' : 'text-muted' %>">
                  <%= (inv.remainingAmount || 0).toLocaleString('ar-IQ') %>
                </td>
                <td style="min-width:120px;">
                  <div class="d-flex align-items-center gap-2">
                    <div class="progress flex-grow-1" style="height:8px;">
                      <div class="progress-bar <%= progress >= 100 ? 'bg-success' : progress > 50 ? 'bg-info' : 'bg-warning' %>" 
                           role="progressbar" style="width: <%= progress %>%"></div>
                    </div>
                    <small class="fw-bold"><%= progress %>%</small>
                  </div>
                </td>
                <td>
                  <span class="badge rounded-pill bg-opacity-10 
                    <%= inv.status === 'paid' ? 'bg-success text-success' : 
                        inv.status === 'partial' ? 'bg-warning text-dark' : 
                        inv.status === 'cancelled' ? 'bg-danger text-danger' : 'bg-secondary text-secondary' %> border">
                    <%= statusLabels[inv.status] || inv.status %>
                  </span>
                </td>
                <td>
                  <div class="d-flex justify-content-center gap-1">
                    <a href="/invoices/<%= inv._id %>" class="btn btn-sm btn-light border" title="عرض">
                      <i class="bi bi-eye text-primary"></i>
                    </a>
                    <a href="/invoices/<%= inv._id %>/print" target="_blank" class="btn btn-sm btn-light border" title="طباعة">
                      <i class="bi bi-printer"></i>
                    </a>
                    <% if (inv.status !== 'paid' && inv.status !== 'cancelled') { %>
                      <button class="btn btn-sm btn-light border" title="إلغاء" onclick="cancelInvoice('<%= inv._id %>')">
                        <i class="bi bi-x-circle text-danger"></i>
                      </button>
                    <% } %>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <% } else { %>
            <div class="text-center py-5">
              <i class="bi bi-file-earmark-text text-muted" style="font-size: 3rem;"></i>
              <h5 class="mt-3">لا توجد نتائج بحث</h5>
              <p class="text-muted">حاول تغيير الفلاتر أو إنشاء فاتورة جديدة.</p>
              <a href="/invoices/new" class="btn btn-primary btn-sm">إضافة أول فاتورة</a>
            </div>
          <% } %>
        </div>

        <%# ترقيم الصفحات (Pagination) %>
        <% if (pagination.totalPages > 1) { %>
        <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center p-3">
          <span class="small text-muted">صفحة <%= pagination.currentPage %> من <%= pagination.totalPages %></span>
          <nav>
            <ul class="pagination pagination-sm mb-0">
              <li class="page-item <%= !pagination.hasPrev ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= pagination.currentPage - 1 %>&status=<%= filters.status %>&search=<%= filters.search %>">السابق</a>
              </li>
              
              <%# عرض أرقام الصفحات يمكن إضافته هنا كحلقة For %>

              <li class="page-item <%= !pagination.hasNext ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= pagination.currentPage + 1 %>&status=<%= filters.status %>&search=<%= filters.search %>">التالي</a>
              </li>
            </ul>
          </nav>
        </div>
        <% } %>
      </div>

    </main>
    <%- include('../partials/footer') %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>

<script>
async function cancelInvoice(id) {
  if (!confirm('هل أنت متأكد من إلغاء هذه الفاتورة؟ لا يمكن التراجع عن هذا الإجراء.')) return;
  
  try {
    const res = await fetch(`/invoices/${id}`, { 
      method: 'DELETE', 
      headers: { 'Content-Type': 'application/json' } 
    });
    const data = await res.json();
    
    if (data.success) {
      location.reload();
    } else {
      alert('❌ فشل الإلغاء: ' + data.message);
    }
  } catch (err) {
    alert('❌ حدث خطأ أثناء الاتصال بالخادم');
  }
}
</script>
</body>
</html>
