<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | <%= clinicName %></title>
  <!-- Bootstrap 5 RTL CDN -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"
  />
</head>
<body class="bg-light">

  <div class="container py-5 text-center">

    <div class="mb-4">
      <!-- أيقونة مؤقتة -->
      <span style="font-size: 4rem;">🦷</span>
    </div>

    <h1 class="display-5 fw-bold text-primary mb-2">
      <%= clinicName %>
    </h1>

    <p class="lead text-muted mb-4">
      نظام إدارة عيادة الأسنان — يعمل بنجاح! ✅
    </p>

    <div class="row justify-content-center g-3">
      <!-- بطاقة اختبار الاتصال بقاعدة البيانات -->
      <div class="col-md-4">
        <div class="card border-success shadow-sm">
          <div class="card-body">
            <h5 class="card-title text-success">🟢 السيرفر</h5>
            <p class="card-text text-muted">Express.js يعمل بنجاح</p>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card border-success shadow-sm">
          <div class="card-body">
            <h5 class="card-title text-success">🟢 قاعدة البيانات</h5>
            <p class="card-text text-muted">MongoDB متصلة بنجاح</p>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card border-success shadow-sm">
          <div class="card-body">
            <h5 class="card-title text-success">🟢 القوالب</h5>
            <p class="card-text text-muted">EJS يعمل بنجاح</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-4">
      <span class="badge bg-secondary">
        البيئة: <%= process.env.NODE_ENV || 'development' %>
      </span>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
